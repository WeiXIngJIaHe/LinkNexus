<Window x:Class="LinkNexus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LinkNexus"
        mc:Ignorable="d"
        Title="LinkNexus - Modern Industrial Multi-Channel Workstation" 
        Height="900" Width="1440"
        MinHeight="780" MinWidth="1200"
        WindowStartupLocation="CenterScreen"
        Background="#0B0E14"
        Foreground="#E1E7EF"
        FontFamily="Segoe UI, Microsoft YaHei, PingFang SC">

    <!-- ======================================================== -->
    <!-- 1. 全局设计资源与工业级深色主题样式定义 -->
    <!-- ======================================================== -->
    <Window.Resources>
        <!-- 基础核心调色板 (Cyber-Industrial Palette) -->
        <SolidColorBrush x:Key="BgDarkBrush" Color="#0B0E14" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#131722" />
        <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#1C2232" />
        <SolidColorBrush x:Key="BorderDarkBrush" Color="#222A3C" />
        <SolidColorBrush x:Key="BorderLightBrush" Color="#333E56" />

        <!-- 科技状态色 -->
        <SolidColorBrush x:Key="AccentCyanBrush" Color="#00D2FF" />
        <SolidColorBrush x:Key="AccentCyanDimBrush" Color="#1A4F6B" />
        <SolidColorBrush x:Key="SuccessGreenBrush" Color="#00E676" />
        <SolidColorBrush x:Key="WarningAmberBrush" Color="#FFAB00" />
        <SolidColorBrush x:Key="ErrorRedBrush" Color="#FF3B30" />
        <SolidColorBrush x:Key="TextDimBrush" Color="#738299" />
        <SolidColorBrush x:Key="TextNormalBrush" Color="#C1CDDD" />
        <SolidColorBrush x:Key="TextBrightBrush" Color="#FFFFFF" />

        <!-- 终端背景色 -->
        <SolidColorBrush x:Key="TerminalBgBrush" Color="#07090D" />

        <!-- 基础工控卡片样式 -->
        <Style x:Key="CyberCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderDarkBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" Direction="270" ShadowDepth="2" Opacity="0.4" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 现代通用按钮样式 -->
        <Style x:Key="ModernBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#1C2333" />
            <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderDarkBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#273147" />
                                <Setter TargetName="bdr" Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#141924" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bdr" Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="No" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 科技强调按钮样式 (霓虹青) -->
        <Style x:Key="AccentBtnStyle" TargetType="Button" BasedOn="{StaticResource ModernBtnStyle}">
            <Setter Property="Background" Value="#007ACC" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#0094F2" />
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#5CE1FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#0063A5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bdr" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 扁平开关 ToggleButton 样式 (工控风格切换滑块) -->
        <Style x:Key="CyberSwitchToggleStyle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bgBorder" Width="40" Height="20" CornerRadius="10" 
                                Background="#252D3E" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                            <Ellipse x:Name="thumb" Width="14" Height="14" HorizontalAlignment="Left" 
                                     Margin="2,0,0,0" Fill="#7E8DA4" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bgBorder" Property="Background" Value="#00804C" />
                                <Setter TargetName="bgBorder" Property="BorderBrush" Value="{StaticResource SuccessGreenBrush}" />
                                <Setter TargetName="thumb" Property="Fill" Value="#FFFFFF" />
                                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="thumb" Property="Margin" Value="0,0,2,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 现代 ComboBox 样式 -->
        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#10141E" />
            <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderDarkBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" 
                                          ClickMode="Press" 
                                          Focusable="False" 
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border" Background="#10141E" BorderBrush="{StaticResource BorderDarkBrush}" 
                                                BorderThickness="1" CornerRadius="5">
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="24" />
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="Arrow" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                      Data="M 0 0 L 3.5 3.5 L 7 0 Z" Fill="{StaticResource TextDimBrush}" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
                                                <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource AccentCyanBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              Margin="8,5,26,5" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" 
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid x:Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="220">
                                    <Border Background="#141824" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="5" Margin="0,3,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" ShadowDepth="4" Direction="270" Opacity="0.6"/>
                                        </Border.Effect>
                                        <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem 悬浮样式 -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextNormalBrush}" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#222B3D" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#005B8A" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 现代输入框 TextBox 样式 -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#0F131C" />
            <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderDarkBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentCyanBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="BorderBrush" Value="{StaticResource BorderLightBrush}" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bdr" Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 现代平滑高光 ProgressBar 样式 -->
        <Style x:Key="ModernProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="8" />
            <Setter Property="Background" Value="#0C0E14" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderDarkBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" ClipToBounds="True">
                            <Grid x:Name="TemplateRoot">
                                <Border x:Name="PART_Track" />
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00A2FF" Offset="0.0" />
                                            <GradientStop Color="#00E676" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ======================================================== -->
    <!-- 2. 主窗体网格：顶部状态栏 + 主体左右两栏架构 -->
    <!-- ======================================================== -->
    <Grid>
        <Grid.RowDefinitions>
            <!-- 行 0: 顶部全局导航与状态栏 (高度 54) -->
            <RowDefinition Height="54" />
            <!-- 行 1: 主体工作区 (左侧电气拓扑 + 右侧多态上下文工作台) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部系统状态栏 (Header) -->
        <Border Grid.Row="0" Background="#10141F" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 左侧: Logo + 软件标题 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="6" Background="#192233" 
                            BorderBrush="{StaticResource AccentCyanBrush}" BorderThickness="1.5" Margin="0,0,10,0">
                        <Path Data="M 6 12 L 12 6 L 18 12 L 12 18 Z M 3 12 H 6 M 18 12 H 21 M 12 3 V 6 M 12 18 V 21" 
                              Stroke="{StaticResource AccentCyanBrush}" StrokeThickness="2" 
                              HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Width="16" Height="16"/>
                    </Border>
                    <TextBlock Text="LinkNexus" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextBrightBrush}" VerticalAlignment="Center"/>
                    <Border Background="#1F283B" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="PRO HARDWARE HUB" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" />
                    </Border>
                    <TextBlock Text="v2.0-industrial" FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 中间: 系统拓扑架构提示 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="TOPOLOGY: 4-CH ISOLATED PROBES + 2-CH DYNAMIC EXT HUB" 
                               FontSize="11" FontWeight="SemiBold" Foreground="#4E5E7A" />
                </StackPanel>

                <!-- 右侧: 全局运行状态呼吸灯 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="12" Background="#161E2D" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" Padding="10,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="10" Height="10" Margin="0,0,7,0">
                                <Ellipse x:Name="BreathingHalo" Width="10" Height="10" Fill="{StaticResource SuccessGreenBrush}" Opacity="0.4">
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.2" To="0.8" Duration="0:0:1.2" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <Ellipse x:Name="StatusDot" Width="5" Height="5" Fill="{StaticResource SuccessGreenBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock x:Name="TxtGlobalStatus" Text="SYSTEM READY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SuccessGreenBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- 主体左右分栏区 (Grid 分割) -->
        <!-- ======================================================== -->
        <Grid Grid.Row="1" Margin="14">
            <Grid.ColumnDefinitions>
                <!-- 左栏: 通道列表与电气拓扑区 (350 宽) -->
                <ColumnDefinition Width="350" />
                <!-- 左右分隔留白 -->
                <ColumnDefinition Width="12" />
                <!-- 右栏: 动态多态工作台区 (自适应) -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ========================================================= -->
            <!-- 1. 【左侧通道列表与电气拓扑区】 (Left Navigation & Power Deck) -->
            <!-- ========================================================= -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <!-- 顶部: 整机总线全局遥测卡片 (固定高度) -->
                    <RowDefinition Height="Auto" />
                    <!-- 留白 -->
                    <RowDefinition Height="10" />
                    <!-- 核心 6 通道交互卡片组 (滚动查看) -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 1.1 整机总线全局遥测卡片 (Bus Telemetry) -->
                <Border Grid.Row="0" Style="{StaticResource CyberCardBorderStyle}" Background="#111622" BorderBrush="#2A354C" Padding="14,12">
                    <StackPanel>
                        <!-- 卡片标题 -->
                        <Grid Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 11 15 H 6 L 13 1 V 9 H 18 L 11 23 V 15 Z" Fill="{StaticResource AccentCyanBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="MAIN BUS POWER TELEMETRY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextBrightBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="24V/5A Rail" FontSize="10" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- 三连仪表遥测读数 (电压 / 电流 / 总功率) -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 总输入电压 -->
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="BUS VOLTAGE" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtBusVoltage" Text="12.02 V" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextBrightBrush}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>

                            <!-- 分割线 -->
                            <Rectangle Grid.Column="1" Fill="{StaticResource BorderDarkBrush}" Height="28"/>

                            <!-- 总工作电流 -->
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="BUS CURRENT" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtBusCurrent" Text="625 mA" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>

                            <!-- 分割线 -->
                            <Rectangle Grid.Column="3" Fill="{StaticResource BorderDarkBrush}" Height="28"/>

                            <!-- 实时总功率 -->
                            <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                <TextBlock Text="TOTAL POWER" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtBusPower" Text="7.51 W" FontSize="15" FontWeight="Bold" Foreground="{StaticResource SuccessGreenBrush}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 1.2 核心 6 组通道卡片列表 -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- 板载通道组标题 -->
                        <TextBlock Text="ISOLATED PROGRAMMER / DEBUG PROBES" FontSize="10" FontWeight="Bold" Foreground="#4E5F7C" Margin="2,0,0,6"/>

                        <!-- 卡片 1: XDS110 高速调试器 -->
                        <Border x:Name="Card_CH1" Style="{StaticResource CyberCardBorderStyle}" Margin="0,0,0,8" Padding="12,10" 
                                Cursor="Hand" MouseDown="ChannelCard_MouseDown" Tag="CH1" BorderBrush="{StaticResource AccentCyanBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#1C263B" CornerRadius="4" Padding="5,2" Margin="0,0,6,0">
                                            <TextBlock Text="CH 01" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}"/>
                                        </Border>
                                        <TextBlock Text="TI XDS110 Probe" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextBrightBrush}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="Badge_CH1" Text="ACTIVE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource SuccessGreenBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="Toggle_CH1" HorizontalAlignment="Right" IsChecked="True" Style="{StaticResource CyberSwitchToggleStyle}" Click="ChannelToggle_Click" Tag="CH1"/>
                                </Grid>
                                <Grid Grid.Row="1">
                                    <TextBlock x:Name="Pwr_CH1" Text="3.30 V  |  160 mA  |  0.53 W" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextNormalBrush}"/>
                                    <TextBlock Text="SWD / JTAG" FontSize="10" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- 卡片 2: DAPLink 调试器 -->
                        <Border x:Name="Card_CH2" Style="{StaticResource CyberCardBorderStyle}" Margin="0,0,0,8" Padding="12,10" 
                                Cursor="Hand" MouseDown="ChannelCard_MouseDown" Tag="CH2">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#1C263B" CornerRadius="4" Padding="5,2" Margin="0,0,6,0">
                                            <TextBlock Text="CH 02" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}"/>
                                        </Border>
                                        <TextBlock Text="ARM DAPLink" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextBrightBrush}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="Badge_CH2" Text="ACTIVE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource SuccessGreenBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="Toggle_CH2" HorizontalAlignment="Right" IsChecked="True" Style="{StaticResource CyberSwitchToggleStyle}" Click="ChannelToggle_Click" Tag="CH2"/>
                                </Grid>
                                <Grid Grid.Row="1">
                                    <TextBlock x:Name="Pwr_CH2" Text="3.31 V  |  145 mA  |  0.48 W" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextNormalBrush}"/>
                                    <TextBlock Text="CMSIS-DAP" FontSize="10" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- 卡片 3: FT2232 双通道 -->
                        <Border x:Name="Card_CH3" Style="{StaticResource CyberCardBorderStyle}" Margin="0,0,0,8" Padding="12,10" 
                                Cursor="Hand" MouseDown="ChannelCard_MouseDown" Tag="CH3">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#1C263B" CornerRadius="4" Padding="5,2" Margin="0,0,6,0">
                                            <TextBlock Text="CH 03" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}"/>
                                        </Border>
                                        <TextBlock Text="FT2232 MPSSE" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextBrightBrush}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="Badge_CH3" Text="ACTIVE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource SuccessGreenBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="Toggle_CH3" HorizontalAlignment="Right" IsChecked="True" Style="{StaticResource CyberSwitchToggleStyle}" Click="ChannelToggle_Click" Tag="CH3"/>
                                </Grid>
                                <Grid Grid.Row="1">
                                    <TextBlock x:Name="Pwr_CH3" Text="5.01 V  |  120 mA  |  0.60 W" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextNormalBrush}"/>
                                    <TextBlock Text="Dual-MPSSE" FontSize="10" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- 卡片 4: 高速虚拟串口 (选中后进入模式 A 串口终端) -->
                        <Border x:Name="Card_CH4" Style="{StaticResource CyberCardBorderStyle}" Margin="0,0,0,12" Padding="12,10" 
                                Cursor="Hand" MouseDown="ChannelCard_MouseDown" Tag="CH4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#253018" CornerRadius="4" Padding="5,2" Margin="0,0,6,0">
                                            <TextBlock Text="UART" FontSize="10" FontWeight="Bold" Foreground="#76E000"/>
                                        </Border>
                                        <TextBlock Text="High-Speed VCP Port" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextBrightBrush}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="Badge_CH4" Text="ACTIVE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource SuccessGreenBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="Toggle_CH4" HorizontalAlignment="Right" IsChecked="True" Style="{StaticResource CyberSwitchToggleStyle}" Click="ChannelToggle_Click" Tag="CH4"/>
                                </Grid>
                                <Grid Grid.Row="1">
                                    <TextBlock x:Name="Pwr_CH4" Text="3.30 V  |   40 mA  |  0.13 W" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextNormalBrush}"/>
                                    <TextBlock Text="Up to 3Mbps" FontSize="10" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- 扩展端口组标题 -->
                        <TextBlock Text="ISOLATED EXPANSION DOWNSTREAM PORTS" FontSize="10" FontWeight="Bold" Foreground="#4E5F7C" Margin="2,0,0,6"/>

                        <!-- 卡片 5: Ext Port 1 (已插入设备) -->
                        <Border x:Name="Card_EXT1" Style="{StaticResource CyberCardBorderStyle}" Margin="0,0,0,8" Padding="12,10" 
                                Cursor="Hand" MouseDown="ChannelCard_MouseDown" Tag="EXT1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#2C203B" CornerRadius="4" Padding="5,2" Margin="0,0,6,0">
                                            <TextBlock Text="EXT 1" FontSize="10" FontWeight="Bold" Foreground="#D183FF"/>
                                        </Border>
                                        <TextBlock Text="USB 3.0 Isolated Hub" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextBrightBrush}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="Badge_EXT1" Text="ATTACHED" FontSize="9" FontWeight="Bold" Foreground="{StaticResource SuccessGreenBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="Toggle_EXT1" HorizontalAlignment="Right" IsChecked="True" Style="{StaticResource CyberSwitchToggleStyle}" Click="ChannelToggle_Click" Tag="EXT1"/>
                                </Grid>
                                <Grid Grid.Row="1">
                                    <TextBlock x:Name="Pwr_EXT1" Text="5.05 V  |  160 mA  |  0.81 W" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextNormalBrush}"/>
                                    <Button Content="Detach Sim" Style="{StaticResource ModernBtnStyle}" Padding="6,2" FontSize="9" HorizontalAlignment="Right" Click="BtnSimulateExt1_Click"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- 卡片 6: Ext Port 2 (未插入设备，半透明状态感应) -->
                        <Border x:Name="Card_EXT2" Style="{StaticResource CyberCardBorderStyle}" Margin="0,0,0,8" Padding="12,10" 
                                Cursor="Hand" MouseDown="ChannelCard_MouseDown" Tag="EXT2" Opacity="0.55" BorderBrush="#252D3D">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#1B2230" CornerRadius="4" Padding="5,2" Margin="0,0,6,0">
                                            <TextBlock Text="EXT 2" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}"/>
                                        </Border>
                                        <TextBlock Text="Type-C High Power" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="Badge_EXT2" Text="UNPLUGGED" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="Toggle_EXT2" HorizontalAlignment="Right" IsChecked="False" Style="{StaticResource CyberSwitchToggleStyle}" Click="ChannelToggle_Click" Tag="EXT2"/>
                                </Grid>
                                <Grid Grid.Row="1">
                                    <TextBlock x:Name="Pwr_EXT2" Text="0.00 V  |    0 mA  |  0.00 W" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}"/>
                                    <Button Content="Attach Sim" Style="{StaticResource ModernBtnStyle}" Padding="6,2" FontSize="9" HorizontalAlignment="Right" Click="BtnSimulateExt2_Click"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ========================================================= -->
            <!-- 2. 【右侧动态工作台区】 (Dynamic Context Workspace) -->
            <!-- ========================================================= -->
            <Grid Grid.Column="2">

                <!-- 模式 A: 串口调试与终端工作台 (选中 CH4 虚拟串口时显示) -->
                <Grid x:Name="WorkspaceSerial" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <!-- 串口参数配置栏 (Auto) -->
                        <RowDefinition Height="Auto" />
                        <!-- 上部: 串口接收监视窗口 (Terminal Monitor) -->
                        <RowDefinition Height="2*" MinHeight="200" />
                        <!-- 中间上下分割条 (GridSplitter) -->
                        <RowDefinition Height="8" />
                        <!-- 下部: 串口发送控制窗口 (Send Box) -->
                        <RowDefinition Height="1*" MinHeight="160" />
                    </Grid.RowDefinitions>

                    <!-- A.1 串口顶部参数栏 -->
                    <Border Grid.Row="0" Style="{StaticResource CyberCardBorderStyle}" Margin="0,0,0,10" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- 端口选择与刷新 -->
                                <TextBlock Text="PORT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="CboPortList" Style="{StaticResource ModernComboBoxStyle}" Width="110" Height="30" Margin="0,0,6,0" />
                                <Button x:Name="BtnRefreshPorts" Style="{StaticResource ModernBtnStyle}" Width="30" Height="30" Padding="0" Click="BtnRefreshPorts_Click" ToolTip="Refresh Serial Ports">
                                    <Path Data="M 17.65 6.35 C 16.2 4.9 14.21 4 12 4 C 7.58 4 4.01 7.58 4.01 12 C 4.01 16.42 7.58 20 12 20 C 15.73 20 18.84 17.45 19.73 14 L 17.65 14 C 16.83 16.33 14.61 18 12 18 C 8.69 18 6 15.31 6 12 C 6 8.69 8.69 6 12 6 C 13.66 6 15.14 6.69 16.22 7.78 L 13 11 L 20 11 L 20 4 L 17.65 6.35 Z" 
                                          Fill="{StaticResource TextNormalBrush}" Stretch="Uniform" Width="12" Height="12"/>
                                </Button>

                                <Border Width="1" Height="18" Background="{StaticResource BorderDarkBrush}" Margin="12,0"/>

                                <!-- 波特率选择 (支持高达 3M 高速) -->
                                <TextBlock Text="BAUD" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="CboBaudRate" Style="{StaticResource ModernComboBoxStyle}" Width="98" Height="30" Margin="0,0,12,0">
                                    <ComboBoxItem Content="9600" />
                                    <ComboBoxItem Content="115200" IsSelected="True" />
                                    <ComboBoxItem Content="460800" />
                                    <ComboBoxItem Content="921600" />
                                    <ComboBoxItem Content="1500000" />
                                    <ComboBoxItem Content="2000000" />
                                    <ComboBoxItem Content="3000000" />
                                </ComboBox>

                                <!-- 校验位/停止位简略参数 -->
                                <TextBlock Text="DATA: 8N1" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                <!-- DTR / RTS 流控 -->
                                <CheckBox x:Name="ChkDTR" Content="DTR" Foreground="{StaticResource TextDimBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" IsChecked="True"/>
                                <CheckBox x:Name="ChkRTS" Content="RTS" Foreground="{StaticResource TextDimBrush}" FontSize="11" VerticalAlignment="Center" IsChecked="True"/>
                            </StackPanel>

                            <!-- 打开/关闭串口连接大按钮 -->
                            <Button x:Name="BtnToggleSerial" Grid.Column="2" Style="{StaticResource AccentBtnStyle}" Height="32" Padding="18,0" Click="BtnToggleSerial_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M 12 2 C 6.48 2 2 6.48 2 12 C 2 17.52 6.48 22 12 22 C 17.52 22 22 17.52 22 12 C 22 6.48 17.52 2 12 2 Z" 
                                          Fill="#FFFFFF" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtToggleSerial" Text="OPEN PORT" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- A.2 接收监视窗口 (Terminal Monitor) -->
                    <Border Grid.Row="1" Style="{StaticResource CyberCardBorderStyle}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- 接收窗口工具栏 -->
                            <Border Grid.Row="0" Background="#0F131D" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0">
                                <Grid Margin="12,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="TERMINAL MONITOR" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}"/>
                                        <Border Width="1" Height="12" Background="{StaticResource BorderDarkBrush}" Margin="10,0"/>
                                        <TextBlock x:Name="TxtRxStats" Text="Rx: 0 Bytes | 0 fps" FontSize="10" Foreground="{StaticResource TextDimBrush}"/>
                                    </StackPanel>

                                    <!-- 右侧控制开关 -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <CheckBox x:Name="ChkTimestamp" Content="Timestamp" IsChecked="True" Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="0,0,10,0"/>
                                        <RadioButton x:Name="RdoAscii" Content="ASCII" IsChecked="True" Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="0,0,6,0"/>
                                        <RadioButton x:Name="RdoHex" Content="HEX" Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="0,0,12,0"/>
                                        <Button Content="Clear" Style="{StaticResource ModernBtnStyle}" Padding="8,2" FontSize="10" Height="22" Click="BtnClearRx_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 接收文本区 (支持 Linux 终端平滑输出) -->
                            <RichTextBox x:Name="RtbSerialRx" Grid.Row="1" 
                                         Background="{StaticResource TerminalBgBrush}" 
                                         Foreground="{StaticResource TextNormalBrush}" 
                                         FontFamily="Consolas, Cascadia Code, Courier New" 
                                         FontSize="12" 
                                         IsReadOnly="True" 
                                         BorderThickness="0" 
                                         VerticalScrollBarVisibility="Auto" 
                                         Padding="10,8" 
                                         Block.LineHeight="16"
                                         Cursor="IBeam">
                                <FlowDocument />
                            </RichTextBox>
                        </Grid>
                    </Border>

                    <!-- 中间分割条 -->
                    <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeNS" VerticalAlignment="Center" />

                    <!-- A.3 发送控制窗口 (Send Box) -->
                    <Border Grid.Row="3" Style="{StaticResource CyberCardBorderStyle}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="36" />
                            </Grid.RowDefinitions>

                            <!-- 发送窗口工具栏 -->
                            <Border Grid.Row="0" Background="#0F131D" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,0,1">
                                <Grid Margin="12,0">
                                    <TextBlock Text="SEND COMMAND BUFFER" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <CheckBox x:Name="ChkSendHex" Content="HEX Send" Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="0,0,10,0"/>
                                        <CheckBox x:Name="ChkAutoSend" Content="Repeat (ms)" Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="0,0,4,0" Click="ChkAutoSend_Click"/>
                                        <TextBox x:Name="TxtRepeatInterval" Style="{StaticResource ModernTextBoxStyle}" Width="45" Height="20" Padding="2,0" Text="1000" FontSize="10" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="TxtTxStats" Text="Tx: 0 Bytes" FontSize="10" Foreground="{StaticResource TextDimBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 多行发送输入框 -->
                            <TextBox x:Name="TxtSendBuffer" Grid.Row="1" 
                                     Background="#0A0C12" Foreground="{StaticResource TextBrightBrush}" 
                                     BorderThickness="0" Padding="10,6" AcceptsReturn="True" 
                                     FontFamily="Consolas, Cascadia Code" FontSize="12" 
                                     VerticalScrollBarVisibility="Auto" Text="AT+VERSION" />

                            <!-- 底部动作条 -->
                            <Border Grid.Row="2" Background="#111622" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,1,0,0">
                                <Grid Margin="10,0">
                                    <TextBlock Text="Press [Enter] or Click Send" FontSize="10" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Content="Clear" Style="{StaticResource ModernBtnStyle}" Padding="12,3" FontSize="11" Height="26" Margin="0,0,8,0" Click="BtnClearTx_Click"/>
                                        <Button x:Name="BtnSendSerial" Content="SEND PACKET" Style="{StaticResource AccentBtnStyle}" Padding="16,3" FontSize="11" Height="26" Click="BtnSendSerial_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 模式 B: 专用固件烧录与调试工作台 (选中 XDS110 / DAP / FT2232 时显示) -->
                <Grid x:Name="WorkspaceProgrammer" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <!-- 固件载入与 CRC 解析区 (Auto) -->
                        <RowDefinition Height="Auto" />
                        <!-- 目标内核分析仪表盘 Core Analyzer (Auto) -->
                        <RowDefinition Height="Auto" />
                        <!-- 烧录进度与动作控制 (Auto) -->
                        <RowDefinition Height="Auto" />
                        <!-- 底部滚动调试日志控制台 (余下所有高度) -->
                        <RowDefinition Height="*" MinHeight="180" />
                    </Grid.RowDefinitions>

                    <!-- B.1 固件载入区 (Firmware Loader Deck) -->
                    <Border Grid.Row="0" Style="{StaticResource CyberCardBorderStyle}" Margin="0,0,0,10" Padding="14,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="FIRMWARE PAYLOAD &amp; CHECKSUM" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextBrightBrush}"/>
                                    <TextBlock x:Name="TxtProbeHeader" Text="[ TARGET PROBE: TI XDS110 (ISOLATED SWD) ]" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" Margin="10,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="Target: Flash 0x08000000" FontSize="10" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- 文件路径与浏览 -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtFirmwareFile" Grid.Column="0" Style="{StaticResource ModernTextBoxStyle}" Height="32" Margin="0,0,8,0"
                                         Text="C:\Releases\LinkNexus_Controller_V2.1.bin" />
                                <Button Content="Browse..." Style="{StaticResource ModernBtnStyle}" Grid.Column="1" Height="32" Padding="16,0" Click="BtnBrowseFirmware_Click"/>
                            </Grid>

                            <!-- 固件文件属性简报卡 -->
                            <Border Background="#0E121B" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TxtFwSize" Grid.Column="0" Text="Payload Size: 256.40 KB" FontSize="10" Foreground="{StaticResource TextNormalBrush}"/>
                                    <TextBlock x:Name="TxtFwCrc" Grid.Column="1" Text="CRC32: 0x9B41E280" FontSize="10" Foreground="{StaticResource AccentCyanBrush}"/>
                                    <TextBlock Text="Format: Raw Binary (.bin)" Grid.Column="2" FontSize="10" Foreground="{StaticResource TextDimBrush}"/>
                                    <TextBlock Text="Target Offset: 0x00000000" Grid.Column="3" FontSize="10" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- B.2 目标内核分析仪表盘 (Core Analyzer) -->
                    <Border Grid.Row="1" Style="{StaticResource CyberCardBorderStyle}" Margin="0,0,0,10" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="TARGET MCU CORE ANALYZER &amp; TELEMETRY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 指标 1: MCU 架构 -->
                                <Border Grid.Column="0" Background="#0F131D" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                    <StackPanel>
                                        <TextBlock Text="MCU ARCHITECTURE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}"/>
                                        <TextBlock Text="ARM Cortex-M4F" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextBrightBrush}" Margin="0,4,0,0"/>
                                        <TextBlock Text="Hardware FPU / DSP" FontSize="9" Foreground="#5A6D8C" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- 指标 2: 工作主频 -->
                                <Border Grid.Column="2" Background="#0F131D" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                    <StackPanel>
                                        <TextBlock Text="CORE CLOCK (HCLK)" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}"/>
                                        <TextBlock Text="168.00 MHz" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" Margin="0,4,0,0"/>
                                        <TextBlock Text="PLL Stabilized" FontSize="9" Foreground="#5A6D8C" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- 指标 3: 目标供电 VDD -->
                                <Border Grid.Column="4" Background="#0F131D" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                    <StackPanel>
                                        <TextBlock Text="TARGET VDD SENSE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}"/>
                                        <TextBlock Text="3.31 V (Nominal)" FontSize="13" FontWeight="Bold" Foreground="{StaticResource SuccessGreenBrush}" Margin="0,4,0,0"/>
                                        <TextBlock Text="Internal LDO Reg" FontSize="9" Foreground="#5A6D8C" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- 指标 4: 内核当前状态 -->
                                <Border Grid.Column="6" Background="#0F131D" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                    <StackPanel>
                                        <TextBlock Text="CORE EXECUTION STATE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Ellipse x:Name="CoreStatusIndicator" Width="8" Height="8" Fill="{StaticResource SuccessGreenBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtCoreStatus" Text="Running (Normal)" FontSize="13" FontWeight="Bold" Foreground="{StaticResource SuccessGreenBrush}"/>
                                        </StackPanel>
                                        <TextBlock Text="SWD Debug Port: Attached" FontSize="9" Foreground="#5A6D8C" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- B.3 烧录进度与动作控制 (Operation & Progress Deck) -->
                    <Border Grid.Row="2" Style="{StaticResource CyberCardBorderStyle}" Margin="0,0,0,10" Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 左半侧: 进度条与传输速率 -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock x:Name="TxtFlasherAction" Text="Ready to program target chip..." FontSize="11" Foreground="{StaticResource TextDimBrush}"/>
                                    <TextBlock x:Name="TxtFlasherPercent" Text="0 % (Idle)" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar x:Name="ProgressFlash" Style="{StaticResource ModernProgressBarStyle}" Height="8" Value="0" Maximum="100"/>
                            </StackPanel>

                            <!-- 右半侧: 独立 3 组烧录动作按钮 -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnErase" Content="ERASE CHIP" Style="{StaticResource ModernBtnStyle}" Height="34" Padding="14,0" Margin="0,0,8,0" Click="BtnErase_Click"/>
                                <Button x:Name="BtnVerify" Content="VERIFY CRC" Style="{StaticResource ModernBtnStyle}" Height="34" Padding="14,0" Margin="0,0,8,0" Click="BtnVerify_Click"/>
                                <Button x:Name="BtnFlashAll" Content="ONE-KEY FLASH" Style="{StaticResource AccentBtnStyle}" Height="34" Padding="18,0" Click="BtnFlashAll_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- B.4 底部滚动调试日志控制台 (Debug Terminal Log) -->
                    <Border Grid.Row="3" Style="{StaticResource CyberCardBorderStyle}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#0F131D" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0">
                                <Grid Margin="12,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="DEBUG &amp; ISP LOG OUTPUT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}"/>
                                        <Border Width="1" Height="10" Background="{StaticResource BorderDarkBrush}" Margin="10,0"/>
                                        <TextBlock Text="Probe Event Stream" FontSize="10" Foreground="{StaticResource TextDimBrush}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <CheckBox x:Name="ChkAutoScrollLog" Content="Auto Scroll" IsChecked="True" Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="0,0,10,0"/>
                                        <Button Content="Clear Console" Style="{StaticResource ModernBtnStyle}" Padding="8,2" FontSize="10" Height="22" Click="BtnClearLog_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <RichTextBox x:Name="RtbDebugLog" Grid.Row="1" 
                                         Background="{StaticResource TerminalBgBrush}" 
                                         Foreground="{StaticResource TextNormalBrush}" 
                                         FontFamily="Consolas, Cascadia Code, Courier New" 
                                         FontSize="12" 
                                         IsReadOnly="True" 
                                         BorderThickness="0" 
                                         VerticalScrollBarVisibility="Auto" 
                                         Padding="10,8" 
                                         Block.LineHeight="16"
                                         Cursor="IBeam">
                                <FlowDocument />
                            </RichTextBox>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
