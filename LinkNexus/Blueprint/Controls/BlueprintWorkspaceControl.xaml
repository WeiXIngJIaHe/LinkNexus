<UserControl x:Class="LinkNexus.Blueprint.Controls.BlueprintWorkspaceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:LinkNexus.Blueprint.Controls"
             xmlns:core="clr-namespace:LinkNexus.Blueprint.Core"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <Style x:Key="PaletteBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource IndustrialBtnBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource IndustrialBtnBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource IndustrialBtnHoverBgBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentCyanBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RunPrimaryBtnStyle" TargetType="Button" BasedOn="{StaticResource PaletteBtnStyle}">
            <Setter Property="BorderBrush" Value="{DynamicResource SuccessGreenBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SuccessGreenBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource AppBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. 顶部节点组件仓库与画布缩放/编排工具栏 -->
        <Border Grid.Row="0"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <DockPanel LastChildFill="False">
                <!-- 左侧：八大核心流式与烧录卡片生成器 -->
                <WrapPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="添加节点"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextMutedBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />

                    <Button Command="{Binding AddComInputNodeCommand}" Style="{StaticResource PaletteBtnStyle}" ToolTip="新建 COM 串口输入采集卡片 (必须指定 USB 枚举端口 · 右键卡片可按需拆分 CH 通道)">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#0EA5E9" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="+ COM 输入" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding AddComOutputNodeCommand}" Style="{StaticResource PaletteBtnStyle}" ToolTip="新建 COM 串口输出下发卡片 (严格绑定真实 USB 枚举端口)">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#10B981" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="+ COM 输出" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding AddMcpInputNodeCommand}" Style="{StaticResource PaletteBtnStyle}" ToolTip="新建 MCP 数据采样与共享节点 (连入指定数据流供 AI Agent 分析并联动调优 Python 算法参数)">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#14B8A6" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="+ MCP 节点" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding AddPythonAlgoNodeCommand}" Style="{StaticResource PaletteBtnStyle}" ToolTip="新建外部隔离 Python 算法卡片 (独立于软件目录之外，支持 Agent 安全调优标量参数)">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#8B5CF6" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="+ Python 算法" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding AddVofaPlotNodeCommand}" Style="{StaticResource PaletteBtnStyle}" ToolTip="新建 VOFA+ 多通道实时波形示波卡片">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#06B6D4" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="+ VOFA+ 绘图" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding AddImu3DPlotNodeCommand}" Style="{StaticResource PaletteBtnStyle}" ToolTip="新建 IMU 三维空间姿态视窗卡片">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#A855F7" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="+ 三维姿态" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding AddCsvSaveNodeCommand}" Style="{StaticResource PaletteBtnStyle}" ToolTip="新建 CSV 高频刷盘存储卡片">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#F59E0B" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="+ CSV 保存" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding AddFlashPortNodeCommand}" Style="{StaticResource PaletteBtnStyle}" ToolTip="新建烧录端口卡片 (支持存放 .hex / .bin 固件，必须指定一个 USB 枚举端口执行烧录)">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#34D399" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="+ 烧录端口" />
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <!-- 右侧：画布滚轮缩放指示、自动排版、全局流控与典型拓扑预设 -->
                <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                    <!-- 缩放控制胶囊 -->
                    <Button Click="ZoomOutBtn_Click"
                            Content="−"
                            Padding="7,4"
                            Margin="0,0,3,0"
                            ToolTip="缩小蓝图画布 (也可直接在画布上滚动鼠标滚轮)"
                            Style="{StaticResource PaletteBtnStyle}" />
                    <Button x:Name="ZoomResetBtn"
                            Click="ZoomResetBtn_Click"
                            Content="100%"
                            FontFamily="Consolas"
                            Padding="7,4"
                            Margin="0,0,3,0"
                            ToolTip="重置画布缩放至 100% (鼠标滚轮可自由缩放 35% ~ 240%)"
                            Style="{StaticResource PaletteBtnStyle}" />
                    <Button Click="ZoomInBtn_Click"
                            Content="+"
                            Padding="7,4"
                            Margin="0,0,6,0"
                            ToolTip="放大蓝图画布 (也可直接在画布上滚动鼠标滚轮)"
                            Style="{StaticResource PaletteBtnStyle}" />

                    <Button Command="{Binding AutoLayoutCommand}"
                            Content="自动排版"
                            ToolTip="按数据流拓扑层级自动摆放所有蓝图节点坐标"
                            Style="{StaticResource PaletteBtnStyle}" />

                    <Button Command="{Binding StartAllStreamsCommand}"
                            Style="{StaticResource RunPrimaryBtnStyle}"
                            ToolTip="启动画布上已指定 USB 端口的采集源节点">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M0,0 L8,5 L0,10 Z" Fill="{DynamicResource SuccessGreenBrush}" Width="8" Height="9" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="启动全部源" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding StopAllStreamsCommand}"
                            Content="停止全部"
                            Style="{StaticResource PaletteBtnStyle}" />

                    <Button Command="{Binding ClearAllWiresCommand}"
                            Content="清空连线"
                            Style="{StaticResource PaletteBtnStyle}" />

                    <Border Width="1" Height="16" Background="{DynamicResource AppBorderBrush}" Margin="3,0,8,0" />

                    <TextBlock Text="预设:"
                               FontSize="11"
                               Foreground="{DynamicResource AppTextMutedBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,5,0" />
                    <Button Command="{Binding LoadDualShowcasePresetCommand}" Content="双链全景" Style="{StaticResource PaletteBtnStyle}" ToolTip="载入 VOFA+ 外部卡尔曼算子、MCP 分析节点与 IMU 三维姿态拓扑" />
                    <Button Command="{Binding LoadVofaFilterPresetCommand}" Content="VOFA+ 示波" Style="{StaticResource PaletteBtnStyle}" ToolTip="载入 COM 采集 -> MCP 分析 -> 外部 Python 滤波 -> VOFA+ 示波链路" />
                    <Button Command="{Binding LoadImuAttitudePresetCommand}" Content="IMU 姿态" Style="{StaticResource PaletteBtnStyle}" ToolTip="载入 IMU 三维姿态与欧拉角同步示波链路" />
                    <Button Command="{Binding LoadMcpTelemetryPresetCommand}" Content="MCP 遥测" Style="{StaticResource PaletteBtnStyle}" Margin="0" ToolTip="载入 MCP 数据分析节点与烧录端口协同链路" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- 2. 中部大尺寸三阶贝塞尔蓝图主画布 (4200x2800，鼠标滚轮以光标为中心自由缩放、空白区拖拽平移、磁吸连线) -->
        <ScrollViewer x:Name="StageScrollViewer"
                      Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      PanningMode="Both"
                      PreviewMouseWheel="StageScrollViewer_PreviewMouseWheel">
            <Grid x:Name="BlueprintStageGrid"
                  Width="4200"
                  Height="2800"
                  Background="Transparent"
                  MouseMove="Stage_MouseMove"
                  MouseLeftButtonUp="Stage_MouseLeftButtonUp"
                  MouseLeftButtonDown="Stage_MouseLeftButtonDown">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="StageScaleTransform" ScaleX="1.0" ScaleY="1.0" />
                </Grid.LayoutTransform>

                <!-- 底层：工程点阵底图 + 已绑定的三阶贝塞尔数据流连线 -->
                <ctrl:BezierWireCanvas x:Name="UnderlayWireCanvas"
                                       Connections="{Binding Connections}"
                                       ShowBackgroundGrid="True"
                                       RenderEstablishedConnections="True" />

                <!-- 中层：自由坐标节点卡片容器 -->
                <ItemsControl x:Name="NodesItemsControl"
                              ItemsSource="{Binding Nodes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas IsItemsHost="True" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X, Mode=TwoWay}" />
                            <Setter Property="Canvas.Top" Value="{Binding Y, Mode=TwoWay}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type core:NodeBase}">
                            <ctrl:NodeCardControl />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 顶层：跨卡片无遮挡实时拖拽贝塞尔预览曲线与磁吸光环 -->
                <ctrl:BezierWireCanvas x:Name="OverlayPreviewCanvas"
                                       IsHitTestVisible="False"
                                       ShowBackgroundGrid="False"
                                       RenderEstablishedConnections="False" />
            </Grid>
        </ScrollViewer>

        <!-- 3. 底部流式管道遥测与端口类型图例栏 -->
        <Border Grid.Row="2"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,5">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="#38BDF8" Margin="0,0,4,0" VerticalAlignment="Center" />
                    <TextBlock Text="通道向量(CH)" FontSize="10.5" Foreground="{DynamicResource AppTextMutedBrush}" Margin="0,0,10,0" />
                    <Ellipse Width="7" Height="7" Fill="#A78BFA" Margin="0,0,4,0" VerticalAlignment="Center" />
                    <TextBlock Text="空间姿态(IMU)" FontSize="10.5" Foreground="{DynamicResource AppTextMutedBrush}" Margin="0,0,10,0" />
                    <Ellipse Width="7" Height="7" Fill="#34D399" Margin="0,0,4,0" VerticalAlignment="Center" />
                    <TextBlock Text="原始帧(RAW)" FontSize="10.5" Foreground="{DynamicResource AppTextMutedBrush}" Margin="0,0,10,0" />
                    <Ellipse Width="7" Height="7" Fill="#FBBF24" Margin="0,0,4,0" VerticalAlignment="Center" />
                    <TextBlock Text="通用端口(ANY)" FontSize="10.5" Foreground="{DynamicResource AppTextMutedBrush}" Margin="0,0,12,0" />

                    <TextBlock FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource AccentCyanBrush}">
                        <Run Text="缩放:" />
                        <Run Text="{Binding CanvasZoomPercentText, Mode=OneWay}" />
                        <Run Text=" · 节点:" />
                        <Run Text="{Binding NodeCount, Mode=OneWay}" />
                        <Run Text=" · 管道:" />
                        <Run Text="{Binding ConnectionCount, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <TextBlock Text="{Binding WorkspaceHint}"
                           FontSize="11"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
