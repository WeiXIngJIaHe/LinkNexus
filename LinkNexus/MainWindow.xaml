<Window x:Class="LinkNexus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LinkNexus"
        mc:Ignorable="d"
        Title="LinkNexus - 多协议桌面硬件调试站"
        Icon="assets/app.ico"
        Height="880" Width="1440"
        MinHeight="720" MinWidth="1180"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#18181B"
        Foreground="#FAFAFA"
        FontFamily="Microsoft YaHei, Segoe UI, PingFang SC"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <!-- 沉浸式隐形标题栏 (WindowChrome) -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" 
                      GlassFrameThickness="0" 
                      CornerRadius="0" 
                      ResizeBorderThickness="6" 
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- 全局样式与调色板资源 -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

        <!-- 工业暗黑调色板 -->
        <SolidColorBrush x:Key="BgDarkBrush" Color="#18181B" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#121215" />
        <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#1A1A20" />
        <SolidColorBrush x:Key="BorderDarkBrush" Color="#27272A" />
        <SolidColorBrush x:Key="BorderLightBrush" Color="#3F3F46" />

        <!-- 科技状态色 -->
        <SolidColorBrush x:Key="AccentCyanBrush" Color="#38BDF8" />
        <SolidColorBrush x:Key="SuccessGreenBrush" Color="#10B981" />
        <SolidColorBrush x:Key="WarningAmberBrush" Color="#F59E0B" />
        <SolidColorBrush x:Key="ErrorRedBrush" Color="#EF4444" />
        <SolidColorBrush x:Key="TextDimBrush" Color="#71717A" />
        <SolidColorBrush x:Key="TextNormalBrush" Color="#D4D4D8" />
        <SolidColorBrush x:Key="TextBrightBrush" Color="#FAFAFA" />

        <!-- 标题栏通用控制按钮样式 -->
        <Style x:Key="CaptionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#27272A" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#18181B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 标题栏关闭按钮样式 -->
        <Style x:Key="CaptionCloseBtnStyle" TargetType="Button" BasedOn="{StaticResource CaptionBtnStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#DC2626" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 工业质感按钮样式 -->
        <Style x:Key="IndustrialBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#27272A" />
            <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderDarkBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#3F3F46" />
                                <Setter TargetName="bdr" Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#18181B" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bdr" Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="No" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 强调型操作按钮样式 -->
        <Style x:Key="AccentActionBtnStyle" TargetType="Button" BasedOn="{StaticResource IndustrialBtnStyle}">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="#38BDF8" />
            <Setter Property="Foreground" Value="#38BDF8" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#0284C7" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#0369A1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 下拉框暗色工业风格与防全白样式 (彻底解决波特率下拉框全白问题) -->
        <Style x:Key="IndustrialComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Foreground" Value="#FAFAFA" />
            <Setter Property="Background" Value="#18181B" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder" Background="{TemplateBinding Background}" 
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#27272A" />
                                <Setter Property="Foreground" Value="#38BDF8" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#0369A1" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="IndustrialComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="btnBorder" Background="{TemplateBinding Background}" 
                    BorderBrush="{TemplateBinding BorderBrush}" 
                    BorderThickness="{TemplateBinding BorderThickness}" 
                    CornerRadius="4" SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="22" />
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#A1A1AA" 
                          HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Width="8" Height="5"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="#38BDF8" />
                    <Setter TargetName="btnBorder" Property="Background" Value="#27272A" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="#38BDF8" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="IndustrialComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#18181B" />
            <Setter Property="Foreground" Value="#FAFAFA" />
            <Setter Property="BorderBrush" Value="#27272A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource IndustrialComboBoxItemStyle}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Template="{StaticResource IndustrialComboBoxToggleButtonTemplate}" 
                                          Background="{TemplateBinding Background}" 
                                          BorderBrush="{TemplateBinding BorderBrush}" 
                                          BorderThickness="{TemplateBinding BorderThickness}" 
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press" Focusable="False" />
                            <ContentPresenter IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                              Margin="8,3,24,3" 
                                              VerticalAlignment="Center" 
                                              HorizontalAlignment="Left" />
                            <Popup x:Name="PART_Popup" 
                                   IsOpen="{TemplateBinding IsDropDownOpen}" 
                                   Placement="Bottom" 
                                   AllowsTransparency="True" 
                                   Focusable="False" 
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder" 
                                        Background="#18181B" 
                                        BorderBrush="#38BDF8" 
                                        BorderThickness="1" 
                                        CornerRadius="4" 
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" 
                                        MaxHeight="240" 
                                        Margin="0,2,0,0">
                                    <Border.Resources>
                                        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource IndustrialScrollBarStyle}"/>
                                    </Border.Resources>
                                    <ScrollViewer SnapsToDevicePixels="True" VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="50" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox" BasedOn="{StaticResource IndustrialComboBoxStyle}" />

        <!-- 设备卡片模板定义 -->
        <DataTemplate x:Key="DeviceCardTemplate">
            <Border Margin="0,0,10,8" Width="310" MinHeight="115" Cursor="Hand" SnapsToDevicePixels="True"
                    CornerRadius="7" Padding="12,10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#121215" />
                        <Setter Property="BorderBrush" Value="#27272A" />
                        <Setter Property="BorderThickness" Value="1.5" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="#38BDF8" />
                                <Setter Property="Background" Value="#0F172A" />
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="10" Direction="0" ShadowDepth="0" Opacity="0.35" Color="#38BDF8"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="{x:Static local:DeviceState.Warning}">
                                <Setter Property="BorderBrush" Value="#F59E0B" />
                                <Setter Property="Background" Value="#1C180B" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding SelectCommand}" />
                </Border.InputBindings>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding DeviceName}" FontSize="12" FontWeight="Bold" Foreground="#FAFAFA" 
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding DeviceName}"/>

                        <Border Grid.Column="1" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="6,0,0,0">
                            <TextBlock Text="{Binding FunctionBadgeText}" FontSize="9" FontWeight="SemiBold" Foreground="#38BDF8"/>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1" BorderBrush="#27272A" BorderThickness="0,0,0,1" VerticalAlignment="Center" Margin="0,2"/>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,4,4">
                            <TextBlock Text="硬件识别码" FontSize="9" Foreground="#71717A"/>
                            <TextBlock Text="{Binding VidPid}" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="#D4D4D8"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,0,4">
                            <TextBlock Text="通信端口 (VCP)" FontSize="9" Foreground="#71717A"/>
                            <TextBlock Text="{Binding ComPort}" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,4,0">
                            <TextBlock Text="硬件序列号" FontSize="9" Foreground="#71717A"/>
                            <TextBlock Text="{Binding SerialNumber}" FontFamily="Consolas" FontSize="9" Foreground="#A1A1AA" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,0,0,0">
                            <TextBlock Text="设备状态" FontSize="9" Foreground="#71717A"/>
                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                <Ellipse Width="5" Height="5" Margin="0,0,4,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#10B981" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="{x:Static local:DeviceState.Warning}">
                                                    <Setter Property="Fill" Value="#F59E0B" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding StatusBadgeText}" FontSize="9" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#10B981" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="{x:Static local:DeviceState.Warning}">
                                                    <Setter Property="Foreground" Value="#F59E0B" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!-- 主窗体根容器 -->
    <Grid Background="#18181B">
        <Grid.RowDefinitions>
            <!-- 行 0: 标题栏 (高 38) -->
            <RowDefinition Height="38" />
            <!-- 行 1: 主体工作区 -->
            <RowDefinition Height="*" />
            <!-- 行 2: 底部状态与版本号条 (高 32) -->
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- 1. 沉浸式隐形标题栏 (纯净去噪，无任何 DEBUG 按钮与冗余说明) -->
        <!-- ========================================================= -->
        <Border Grid.Row="0" Background="#121215" BorderBrush="#27272A" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 左侧: 品牌徽标 + 主标题 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Path Data="M 12 2 L 2 7 L 12 12 L 22 7 Z M 2 17 L 12 22 L 22 17 M 2 12 L 12 17 L 22 12" 
                          Stroke="{StaticResource AccentCyanBrush}" StrokeThickness="1.8" 
                          HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Width="15" Height="15" Margin="0,0,9,0"/>
                    <TextBlock Text="LinkNexus" FontSize="13" FontWeight="Bold" Foreground="#FAFAFA" VerticalAlignment="Center"/>
                    <Border Background="#27272A" CornerRadius="3" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="多协议桌面硬件调试站" FontSize="10" Foreground="#A1A1AA" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- 中间: 纯净留白拖拽区 (仅在点击 5 次开启 Debug 模式时显示极简指示) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#1C180B" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="4" Padding="8,2" 
                            Visibility="{Binding DebugModeTagVisibility}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="#F59E0B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="🛠️ 开发者维护模式 (已解锁 ESP32 主控救砖、通道 MOS 供电控制与拓扑热重载)" FontSize="10" FontWeight="SemiBold" Foreground="#F59E0B" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource IndustrialBtnStyle}" Content="重载配置" Height="20" Padding="6,0" FontSize="9" Margin="8,0,0,0" 
                                    Command="{Binding ReloadConfigCommand}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 右侧: 刷新总线与窗口控制按钮组 (无 DEBUG 开关) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IndustrialBtnStyle}" Content="刷新总线" Height="26" Padding="8,2" Margin="0,0,12,0" 
                            Command="{Binding TriggerScanCommand}" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="立即触发 Windows PnP 全量设备枚举"/>

                    <Button Style="{StaticResource CaptionBtnStyle}" Click="BtnWindowMinimize_Click" ToolTip="最小化">
                        <Path Data="M 0 0 H 10" Stroke="{StaticResource TextNormalBrush}" StrokeThickness="1.2" SnapsToDevicePixels="True"/>
                    </Button>

                    <Button Style="{StaticResource CaptionBtnStyle}" Click="BtnWindowMaximize_Click" ToolTip="最大化 / 还原">
                        <Path x:Name="PathMaximizeIcon" Data="M 0 0 H 10 V 10 H 0 Z" Stroke="{StaticResource TextNormalBrush}" StrokeThickness="1.2" SnapsToDevicePixels="True"/>
                    </Button>

                    <Button Style="{StaticResource CaptionCloseBtnStyle}" Click="BtnWindowClose_Click" ToolTip="关闭">
                        <Path Data="M 0 0 L 10 10 M 10 0 L 0 10" Stroke="{StaticResource TextNormalBrush}" StrokeThickness="1.2" SnapsToDevicePixels="True"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================= -->
        <!-- 2. 主体工作区 (双主页面: 正常物理监控页面 vs Debug 工程维护与虚拟调试新页面) -->
        <!-- ========================================================= -->
        <Grid Grid.Row="1" Margin="16,12,16,10">
            <!-- ========================================================= -->
            <!-- 视图 1: 正常物理硬件监控页面 (未进入 Debug 模式时全屏呈现) -->
            <!-- ========================================================= -->
            <Grid Visibility="{Binding IsNormalModeVisible, Converter={StaticResource BoolToVisConverter}}">
                <Grid.RowDefinitions>
                    <!-- 顶部: 动态平铺 CH338X 下行硬件设备卡片流 + 外部设备抽屉按钮 -->
                    <RowDefinition Height="Auto" />
                    <!-- 间距 -->
                    <RowDefinition Height="12" />
                    <!-- 下部: 选定设备独立工作页面 (烧录 / 串口 CLI / 通用设备 / 系统流) -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

            <!-- 2.1 顶部: 动态设备卡片流与抽屉入口 -->
            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 无设备接入时的空态提示 -->
                <Border Grid.Row="0" Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="14,18">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasConnectedDevices}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="M 12 2 C 6.48 2 2 6.48 2 12 C 2 17.52 6.48 22 12 22 C 17.52 22 22 17.52 22 12 C 22 6.48 17.52 2 12 2 Z M 13 17 H 11 V 15 H 13 V 17 Z M 13 13 H 11 V 7 H 13 V 13 Z"
                              Fill="#71717A" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="当前未检测到任何 CH338X 下行核心硬件设备，请通过 USB 接口接入开发板/调试器..." FontSize="12" Foreground="#71717A" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 核心 CH338X 下行卡片流 + 抽屉切换按钮栏 -->
                <WrapPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- CH338X 下行设备卡片 (FT2232, CH343P, XDS110, DAP，以及 Debug 模式的 ESP32) -->
                    <ItemsControl ItemsSource="{Binding ConnectedDevices}" ItemTemplate="{StaticResource DeviceCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- 当 ESP32 识别成功，其他 USB 设备隐藏为抽屉按钮 (核心要求 1) -->
                    <Border Visibility="{Binding HasOtherDevices, Converter={StaticResource BoolToVisConverter}}" 
                            Margin="0,0,10,8" VerticalAlignment="Top">
                        <Button Style="{StaticResource IndustrialBtnStyle}" Content="{Binding OtherDevicesDrawerButtonText}" 
                                Command="{Binding ToggleOtherDevicesDrawerCommand}" Height="30" Padding="12,0" FontSize="11"
                                ToolTip="点击展开/收起操作系统枚举到的其他通用 USB 外设"/>
                    </Border>
                </WrapPanel>

                <!-- 外部 USB 外设抽屉面板 (Drawer Panel - 核心要求 1) -->
                <Border Grid.Row="1" Background="#0C0C0E" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" 
                        Padding="12,10" Margin="0,4,0,8"
                        Visibility="{Binding IsOtherDevicesDrawerOpen, Converter={StaticResource BoolToVisConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="📂 操作系统识别的其他 USB 外设抽屉 (点击卡片可查看其底层硬件属性)" FontSize="11" FontWeight="Bold" Foreground="#A1A1AA" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource IndustrialBtnStyle}" Content="✕ 收起抽屉" Height="22" Padding="8,0" FontSize="10" 
                                    HorizontalAlignment="Right" Command="{Binding ToggleOtherDevicesDrawerCommand}"/>
                        </Grid>

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding OtherDevices}" ItemTemplate="{StaticResource DeviceCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>

            <!-- 2.2 下部: 选定设备独立工作页面 -->
            <Border Grid.Row="2" Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <!-- ========================================================= -->
                    <!-- 独立工作页面 A: FT2232 / XDS110 / DAPLink 固件烧录与内核调试工作台 -->
                    <!-- 独立工作页面 A: FT2232 / XDS110 / DAPLink 固件烧录与内核调试工作台 (支持垂直滚动以适配多设备堆叠) -->
                    <!-- ========================================================= -->
                    <ScrollViewer Visibility="{Binding IsBurnerWorkspaceVisible, Converter={StaticResource BoolToVisConverter}}"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <Grid Margin="0,0,6,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                        <!-- 行 0: 设备标题与内核运行状态 -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M 13 2 L 3 14 H 12 L 11 22 L 21 10 H 12 L 13 2 Z" Fill="#38BDF8" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedDevice.DeviceName, StringFormat={}{0} — 独立固件烧录与片上内核工作台}" 
                                           FontSize="13" FontWeight="Bold" Foreground="#FAFAFA" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="4" Padding="8,3" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding KernelStateText}" FontSize="10" FontFamily="Consolas" Foreground="#34D399"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 行 1: 固件文件拖拽放入区 (Dropzone) -->
                        <Border Grid.Row="1" Background="#18181B" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10"
                                AllowDrop="True" Drop="FileDropZone_Drop" DragOver="FileDropZone_DragOver">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📂 固件镜像:" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding CurrentLoadedFile.FileName}" FontSize="11" FontWeight="Bold" Foreground="#FAFAFA" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="大小: " FontSize="10" Foreground="#71717A"/>
                                        <TextBlock Text="{Binding CurrentLoadedFile.FileSizeText}" FontSize="10" Foreground="#A1A1AA" Margin="0,0,12,0"/>
                                        <TextBlock Text="CRC32: " FontSize="10" Foreground="#71717A"/>
                                        <TextBlock Text="{Binding CurrentLoadedFile.Crc32Text}" FontFamily="Consolas" FontSize="10" Foreground="#38BDF8" Margin="0,0,12,0"/>
                                        <TextBlock Text="匹配架构: " FontSize="10" Foreground="#71717A"/>
                                        <TextBlock Text="{Binding CurrentLoadedFile.TargetChipFamily}" FontSize="10" Foreground="#10B981"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                                    <TextBlock Text="烧录基地址: " FontSize="10" Foreground="#71717A" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding LoadBaseAddress, UpdateSourceTrigger=PropertyChanged}" Width="90" Height="24"
                                             Background="#121215" Foreground="#38BDF8" BorderBrush="#27272A" FontFamily="Consolas" FontSize="10" Padding="4,2" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Button Grid.Column="2" Style="{StaticResource IndustrialBtnStyle}" Content="浏览放入固件..." Height="26" Padding="10,2"
                                        Command="{Binding BrowseFileCommand}"/>
                            </Grid>
                        </Border>

                        <!-- 行 2: 内核操作组件工具栏 -->
                        <Border Grid.Row="2" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,10">
                            <WrapPanel VerticalAlignment="Center">
                                <Button Style="{StaticResource AccentActionBtnStyle}" Content="▶ 开始执行固件烧录" Height="28" Padding="12,0" Margin="0,0,8,0"
                                        Command="{Binding StartPreviewFlashCommand}" ToolTip="执行流式写入、扇区擦除与片上 CRC32 严格校验"/>
                                <Button Style="{StaticResource IndustrialBtnStyle}" Content="📖 读取扇区数据 (Read Sector)" Height="28" Margin="0,0,8,0"
                                        Command="{Binding ReadSectorCommand}" ToolTip="从目标 MCU 基地址读取 256 字节并在下方 Hex 转储视窗呈现"/>
                                <Button Style="{StaticResource IndustrialBtnStyle}" Content="🧹 整片快速擦除 (Chip Erase)" Height="28" Margin="0,0,8,0"
                                        Command="{Binding ChipEraseCommand}" ToolTip="执行全片扇区擦除并校验空片"/>
                                <Button Style="{StaticResource IndustrialBtnStyle}" Content="⚡ 读取芯片 CoreID" Height="28" Margin="0,0,8,0"
                                        Command="{Binding ReadCoreIdCommand}" ToolTip="在线查询目标 MCU 内核 CoreID 寄存器"/>
                                <Button Style="{StaticResource IndustrialBtnStyle}" Content="🔄 硬件/系统复位 (SYSRESET)" Height="28"
                                        Command="{Binding ResetTargetCommand}" ToolTip="拉低复位引脚或触发内核 SYSRESETREQ"/>
                            </WrapPanel>
                        </Border>

                        <!-- 行 3: 烧录进度与速率反馈 -->
                        <Grid Grid.Row="3" Margin="0,0,0,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ProgressBar Grid.Row="0" Height="5" Value="{Binding FlashProgress}" Minimum="0" Maximum="100" 
                                         Foreground="#38BDF8" Background="#27272A" BorderThickness="0" Margin="0,0,0,4"/>
                            <Grid Grid.Row="1">
                                <TextBlock Text="{Binding FlashStatusStep}" FontSize="10" Foreground="#A1A1AA" HorizontalAlignment="Left"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding FlashSpeedText, StringFormat=传输速率: {0}}" FontSize="10" Foreground="#38BDF8" Margin="0,0,12,0"/>
                                    <TextBlock Text="{Binding FlashProgress, StringFormat=进度: {0}%}" FontSize="10" FontWeight="Bold" Foreground="#10B981"/>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- 行 4: 扇区 Hex 转储与内核日志双视窗 -->
                        <Grid Grid.Row="4" Height="260" Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#0C0C0E" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="扇区内存转储视窗 (Sector Hex Dump 0x08000000 - 0x08000100)" FontSize="10" FontWeight="Bold" Foreground="#FAFAFA" Margin="0,0,0,6"/>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding SectorHexDumpLines}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11" Foreground="#38BDF8" Margin="0,1"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Background="#0C0C0E" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="内核操作流水记录 (Kernel Transaction Logs)" FontSize="10" FontWeight="Bold" Foreground="#FAFAFA" Margin="0,0,0,6"/>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Logs}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock FontFamily="Consolas" FontSize="10" Foreground="#A1A1AA" Margin="0,1" TextWrapping="Wrap">
                                                        <Run Text="{Binding TimeString, Mode=OneWay, StringFormat=[{0}]}" Foreground="#71717A"/>
                                                        <Run Text=" "/>
                                                        <Run Text="{Binding Message, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                    </ScrollViewer>

                    <!-- ========================================================= -->
                    <!-- 独立工作页面 B: CH343P / UART 串口调试与 Linux CLI 工作台 -->
                    <!-- ========================================================= -->
                    <Grid Visibility="{Binding IsUartWorkspaceVisible, Converter={StaticResource BoolToVisConverter}}">
                        <Grid.RowDefinitions>
                            <!-- 行 0: 串口参数、DTR/RTS/CTS 硬件引脚与工作台视窗模式 -->
                            <RowDefinition Height="Auto" />
                            <!-- 行 1: 智能分流工作区 (Linux CLI 终端 + 串口数据监视) -->
                            <RowDefinition Height="*" />
                            <!-- 行 2: 智能自动识别输入条 (自动识别 Linux CLI / HEX / AT / 字符串) -->
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 行 0: 串口参数工具栏与硬件引脚控制 -->
                        <Border Grid.Row="0" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 左侧: 端口、波特率、串口开关、硬件引脚 (DTR/RTS/CTS/DSR/Reset) -->
                                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="通信端口: " FontSize="10" Foreground="#71717A" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SelectedDevice.ComPort}" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                    <TextBlock Text="波特率: " FontSize="10" Foreground="#71717A" VerticalAlignment="Center"/>
                                    <ComboBox ItemsSource="{Binding AvailableBaudRates}" SelectedItem="{Binding SelectedBaudRate}" 
                                              Width="88" Height="24" FontSize="10" Margin="0,0,10,0" VerticalAlignment="Center"/>

                                    <Border Background="#27272A" CornerRadius="3" Padding="5,1" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="8 - None - 1" FontSize="9" Foreground="#A1A1AA"/>
                                    </Border>

                                    <Button Content="{Binding PortOpenButtonText}" Height="24" Padding="10,0" FontSize="10" Margin="0,0,10,0"
                                            Command="{Binding ToggleSerialPortCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource IndustrialBtnStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPortOpen}" Value="True">
                                                        <Setter Property="Background" Value="#064E3B" />
                                                        <Setter Property="BorderBrush" Value="#10B981" />
                                                        <Setter Property="Foreground" Value="#34D399" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- 硬件控制引脚: DTR 开关 -->
                                    <Button Command="{Binding ToggleDtrCommand}" Height="24" Padding="8,0" FontSize="10" Margin="0,0,6,0"
                                            ToolTip="切换 DTR (Data Terminal Ready) 输出引脚状态">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource IndustrialBtnStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDtrEnable}" Value="True">
                                                        <Setter Property="Background" Value="#064E3B" />
                                                        <Setter Property="BorderBrush" Value="#10B981" />
                                                        <Setter Property="Foreground" Value="#34D399" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Text="{Binding DtrButtonText}"/>
                                    </Button>

                                    <!-- 硬件控制引脚: RTS 开关 -->
                                    <Button Command="{Binding ToggleRtsCommand}" Height="24" Padding="8,0" FontSize="10" Margin="0,0,6,0"
                                            ToolTip="切换 RTS (Request To Send) 输出引脚状态">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource IndustrialBtnStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRtsEnable}" Value="True">
                                                        <Setter Property="Background" Value="#064E3B" />
                                                        <Setter Property="BorderBrush" Value="#10B981" />
                                                        <Setter Property="Foreground" Value="#34D399" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Text="{Binding RtsButtonText}"/>
                                    </Button>

                                    <!-- CTS 硬件状态指示 -->
                                    <Border Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="3" Padding="5,2" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="CTS (Clear To Send) 硬件握手就绪指示">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="CTS" FontSize="9" FontWeight="Bold" Foreground="#A1A1AA"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- DSR / DTS 硬件状态指示 -->
                                    <Border Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="3" Padding="5,2" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="DSR / DTS (Data Set Ready) 硬件载波状态指示">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="DSR(DTS)" FontSize="9" FontWeight="Bold" Foreground="#A1A1AA"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 硬件复位脉冲 -->
                                    <Button Style="{StaticResource IndustrialBtnStyle}" Content="⚡ DTR/RTS 脉冲复位" Height="24" Padding="8,0" FontSize="10"
                                            Command="{Binding TriggerMcuResetCommand}" ToolTip="执行 DTR/RTS 硬件时序脉冲复位下位机/开发板 (ESP32/STM32)"/>
                                </WrapPanel>

                                <!-- 右侧: 视窗布局切换 (智能双视窗 / 纯 CLI / 纯串口监视) -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource IndustrialBtnStyle}" Content="🤖 智能双视窗" Height="22" Padding="7,0" FontSize="9" Margin="0,0,4,0"
                                            Command="{Binding SetSerialViewModeCommand}" CommandParameter="0"/>
                                    <Button Style="{StaticResource IndustrialBtnStyle}" Content="🐧 纯 CLI" Height="22" Padding="7,0" FontSize="9" Margin="0,0,4,0"
                                            Command="{Binding SetSerialViewModeCommand}" CommandParameter="1"/>
                                    <Button Style="{StaticResource IndustrialBtnStyle}" Content="📡 纯串口监视" Height="22" Padding="7,0" FontSize="9"
                                            Command="{Binding SetSerialViewModeCommand}" CommandParameter="2"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 行 1: 智能分流工作区 (Linux CLI 终端 + 串口数据监视) -->
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <!-- 左列: Linux CLI 终端 -->
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="8" />
                                <!-- 右列: 串口数据与 HEX 监视器 -->
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>

                            <!-- 左列: 🐧 Linux 卡片机 CLI 交互终端 -->
                            <Grid Grid.Column="0" Visibility="{Binding IsLinuxCliAreaVisible, Converter={StaticResource BoolToVisConverter}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- 快捷命令注入条 -->
                                <WrapPanel Grid.Row="0" Margin="0,0,0,6">
                                    <TextBlock Text="快捷注入:" FontSize="9" Foreground="#71717A" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Button Style="{StaticResource IndustrialBtnStyle}" Content="uname -a" Height="20" Padding="5,0" FontSize="8" Margin="0,0,4,2" Command="{Binding InjectCliPresetCommand}" CommandParameter="uname -a"/>
                                    <Button Style="{StaticResource IndustrialBtnStyle}" Content="ifconfig -a" Height="20" Padding="5,0" FontSize="8" Margin="0,0,4,2" Command="{Binding InjectCliPresetCommand}" CommandParameter="ifconfig -a"/>
                                    <Button Style="{StaticResource IndustrialBtnStyle}" Content="dmesg | tail" Height="20" Padding="5,0" FontSize="8" Margin="0,0,4,2" Command="{Binding InjectCliPresetCommand}" CommandParameter="dmesg | tail -n 20"/>
                                    <Button Style="{StaticResource IndustrialBtnStyle}" Content="top (负载)" Height="20" Padding="5,0" FontSize="8" Margin="0,0,4,2" Command="{Binding InjectCliPresetCommand}" CommandParameter="top -b -n 1"/>
                                    <Button Style="{StaticResource IndustrialBtnStyle}" Content="reboot" Height="20" Padding="5,0" FontSize="8" Margin="0,0,4,2" Command="{Binding InjectCliPresetCommand}" CommandParameter="reboot"/>
                                    <Button Style="{StaticResource IndustrialBtnStyle}" Content="clear" Height="20" Padding="5,0" FontSize="8" Margin="0,0,4,2" Command="{Binding InjectCliPresetCommand}" CommandParameter="clear"/>
                                </WrapPanel>

                                <!-- Linux 终端显示区 -->
                                <Border Grid.Row="1" Background="#0C0C0E" BorderBrush="#27272A" BorderThickness="1" CornerRadius="5" Padding="8">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding LinuxCliTerminalLines}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11" Foreground="#38BDF8" Margin="0,1" TextWrapping="Wrap"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Grid>

                            <!-- 分割栏 (仅在双视窗模式时显示) -->
                            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#18181B" 
                                          Visibility="{Binding IsSmartDualViewVisible, Converter={StaticResource BoolToVisConverter}}"/>

                            <!-- 右列: 📡 实时串口数据监视与 HEX 分析器 -->
                            <Border Grid.Column="2" Background="#0C0C0E" BorderBrush="#27272A" BorderThickness="1" CornerRadius="5" Padding="8"
                                    Visibility="{Binding IsSerialMonitorAreaVisible, Converter={StaticResource BoolToVisConverter}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- 监视器控制栏 -->
                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="数据接收监视 (Rx)" FontSize="10" FontWeight="Bold" Foreground="#FAFAFA" VerticalAlignment="Center"/>
                                            <CheckBox Content="HEX 接收" IsChecked="{Binding IsHexReceiveMode}" Foreground="#71717A" FontSize="9" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            <CheckBox Content="时间戳" IsChecked="{Binding IsTimestampEnabled}" Foreground="#71717A" FontSize="9" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SerialTxBytes, StringFormat=TX: {0}B}" FontSize="9" Foreground="#71717A" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding SerialRxBytes, StringFormat=RX: {0}B}" FontSize="9" Foreground="#10B981" Margin="0,0,6,0"/>
                                            <Button Style="{StaticResource IndustrialBtnStyle}" Content="清空" Height="18" Padding="5,0" FontSize="8" 
                                                    Command="{Binding ClearSerialMonitorCommand}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 串口数据行 -->
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding SerialMonitorLines}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="10" Foreground="#34D399" Margin="0,1" TextWrapping="Wrap"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 行 2: 智能自动识别输入条 (自动识别 Linux CLI / HEX / AT / 字符串) -->
                        <Border Grid.Row="2" Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="5" Padding="8,6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- 自动识别分类指示标签 -->
                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border BorderBrush="{Binding DetectedInputBadgeColor}" BorderThickness="1" CornerRadius="3" Padding="6,1" Background="#18181B">
                                            <TextBlock Text="{Binding DetectedInputType}" FontSize="9" FontWeight="Bold" Foreground="{Binding DetectedInputBadgeColor}"/>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="模式锁定:" FontSize="9" Foreground="#71717A" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <RadioButton Content="🤖 智能自适应" IsChecked="True" Foreground="#FAFAFA" FontSize="9" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <CheckBox Content="追加 \r\n" IsChecked="{Binding IsAppendNewLine}" Foreground="#71717A" FontSize="9" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 智能输入交互行 -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="root@linknexus-board:~# " FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center" Margin="2,0,4,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding SmartInputBuffer, UpdateSourceTrigger=PropertyChanged}" 
                                             KeyDown="SmartInputTextBox_KeyDown"
                                             Height="26" Background="#18181B" Foreground="#FAFAFA" BorderBrush="#27272A" BorderThickness="1" 
                                             FontFamily="Consolas" FontSize="11" Padding="6,3" VerticalAlignment="Center"/>
                                    <Button Grid.Column="2" Style="{StaticResource AccentActionBtnStyle}" Content="▶ 执行 / 发送 (Enter)" Height="26" Padding="14,0" FontSize="10" Margin="6,0,0,0"
                                            Command="{Binding SendSmartInputCommand}" ToolTip="自动按识别到的类型发送 (支持直接按回车键)"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ========================================================= -->
                    <!-- 独立工作页面 D: 通用 USB 设备 / 外部存储工作台 (抽屉设备查看) -->
                    <!-- ========================================================= -->
                    <Grid Visibility="{Binding IsGenericWorkspaceVisible, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Path Data="M 12 2 L 2 7 L 12 12 L 22 7 Z M 2 17 L 12 22 L 22 17 M 2 12 L 12 17 L 22 12" 
                                  Stroke="{StaticResource AccentCyanBrush}" StrokeThickness="2" Width="40" Height="40" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                            <TextBlock Text="{Binding SelectedDevice.DeviceName}" FontSize="15" FontWeight="Bold" Foreground="#FAFAFA" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedDevice.DeviceDescription}" FontSize="11" Foreground="#71717A" HorizontalAlignment="Center" Margin="0,4,0,16"/>

                            <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="16" MinWidth="420">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedDevice.VidPid, StringFormat=硬件识别码：{0}}" FontFamily="Consolas" FontSize="11" Foreground="#38BDF8"/>
                                    <TextBlock Text="{Binding SelectedDevice.SerialNumber, StringFormat=设备序列号：{0}}" FontFamily="Consolas" FontSize="11" Foreground="#A1A1AA" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding SelectedDevice.HardwarePath, StringFormat=实例路径：{0}}" FontFamily="Consolas" FontSize="10" Foreground="#71717A" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding SelectedDevice.StatusMessage, StringFormat=驱动状态：{0}}" FontSize="11" Foreground="#10B981" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ========================================================= -->
                    <!-- 全局系统 PnP 诊断事件流终端 (未选定特定设备时呈现) -->
                    <!-- ========================================================= -->
                    <Grid Visibility="{Binding IsLogsWorkspaceVisible, Converter={StaticResource BoolToVisConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="Windows 全量 PnP 硬件插拔与总线拓扑监控流" FontSize="12" FontWeight="Bold" Foreground="#FAFAFA" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource IndustrialBtnStyle}" Content="清空日志" Height="22" Padding="8,1" FontSize="10" 
                                    HorizontalAlignment="Right" Command="{Binding ClearLogsCommand}"/>
                        </Grid>

                        <Border Grid.Row="1" Background="#0C0C0E" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
                                <ItemsControl ItemsSource="{Binding Logs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding TimeString, StringFormat=[{0}]}" 
                                                           FontFamily="Consolas" FontSize="10" Foreground="#71717A" Margin="0,0,8,0" VerticalAlignment="Center"/>

                                                <Border Grid.Column="1" CornerRadius="3" Padding="4,1" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#27272A" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Level}" Value="SUCCESS">
                                                                    <Setter Property="Background" Value="#064E3B" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Level}" Value="WARN">
                                                                    <Setter Property="Background" Value="#78350F" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Level}" Value="ERROR">
                                                                    <Setter Property="Background" Value="#7F1D1D" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Level}" FontSize="9" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#A1A1AA" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Level}" Value="SUCCESS">
                                                                        <Setter Property="Foreground" Value="#34D399" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Level}" Value="WARN">
                                                                        <Setter Property="Foreground" Value="#FBBF24" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Level}" Value="ERROR">
                                                                        <Setter Property="Foreground" Value="#F87171" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>

                                                <TextBlock Grid.Column="2" Text="{Binding Message}" FontFamily="Consolas, Microsoft YaHei" FontSize="11" 
                                                           Foreground="#D4D4D8" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================================= -->
        <!-- 视图 2: 全新 Debug 开发者工程维护与虚拟调试新页面 (进入 Debug 模式时全屏切换) -->
        <!-- ========================================================= -->
        <Grid Visibility="{Binding IsDebugModeVisible, Converter={StaticResource BoolToVisConverter}}">
            <Grid.RowDefinitions>
                <!-- 行 0: Debug 专属顶栏 -->
                <RowDefinition Height="Auto" />
                <!-- 间距 -->
                <RowDefinition Height="10" />
                <!-- 行 1: 固件救砖刷写 &amp; 4 路物理 MOS 供电控制矩阵 (硬件底层维护) -->
                <RowDefinition Height="Auto" />
                <!-- 间距 -->
                <RowDefinition Height="10" />
                <!-- 行 2: 虚拟接入功能与核心引擎测试工作台 (用来测试里面的功能) -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 行 0: Debug 专属顶栏 -->
            <Border Grid.Row="0" Background="#121215" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="6" Padding="14,8">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="#F59E0B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="🛠️ LinkNexus 开发者工程维护总控中心 (DEBUG 专属总台)" FontSize="12" FontWeight="Bold" Foreground="#FAFAFA" VerticalAlignment="Center"/>
                        <Border Background="#1C180B" BorderBrush="#78350F" BorderThickness="1" CornerRadius="3" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ROM Bootloader &amp; Virtual Simulation Active" FontSize="9" FontFamily="Consolas" Foreground="#F59E0B"/>
                        </Border>
                        <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="3" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DaemonStatusText}" FontSize="9" Foreground="#A1A1AA"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource IndustrialBtnStyle}" Content="⚙️ 重载硬件配置" Height="24" Padding="10,0" FontSize="10" Margin="0,0,8,0"
                                Command="{Binding ReloadConfigCommand}" ToolTip="热重载 HardwareConfig.json 配置文件"/>
                        <Button Style="{StaticResource AccentActionBtnStyle}" Content="✕ 退出 Debug 模式" Height="24" Padding="10,0" FontSize="10"
                                Command="{Binding ExitDebugModeCommand}" ToolTip="返回正常物理设备极简监控模式"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 行 1: 固件救砖刷写 &amp; 4 路物理 MOS 供电控制矩阵 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <!-- 左列: 板载固件一键救砖与覆盖区 -->
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="10" />
                    <!-- 右列: 4 路下行通道物理 MOS 供电控制矩阵 -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左列: 固件救砖与覆盖区 -->
                <Border Grid.Column="0" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="12,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="⚡ 板载各引擎固件一键救砖覆盖 (Embedded Resource Flash)" FontSize="11" FontWeight="Bold" Foreground="#FAFAFA" Margin="0,0,0,8"/>

                        <WrapPanel Grid.Row="1" Margin="0,0,0,6">
                            <Button Style="{StaticResource AccentActionBtnStyle}" Content="🛠️ 刷入主控固件 (ESP32-S3)" Height="25" Padding="8,0" Margin="0,0,6,4"
                                    Command="{Binding FlashEsp32MasterFirmwareCommand}"/>
                            <Button Style="{StaticResource IndustrialBtnStyle}" Content="⚡ 覆盖 TM4C DFU 镜像" Height="25" Padding="8,0" Margin="0,0,6,4"
                                    Command="{Binding FlashTm4cDfuMirrorCommand}"/>
                            <Button Style="{StaticResource IndustrialBtnStyle}" Content="🔄 覆盖 DAPLink 固件" Height="25" Padding="8,0" Margin="0,0,6,4"
                                    Command="{Binding FlashDapLinkFirmwareCommand}"/>
                            <Button Style="{StaticResource IndustrialBtnStyle}" Content="⚙️ 恢复出厂拓扑" Height="25" Padding="8,0" Margin="0,0,0,4"
                                    Command="{Binding FactoryResetCommand}"/>
                        </WrapPanel>

                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ProgressBar Grid.Row="0" Height="4" Value="{Binding Esp32FlashProgress}" Minimum="0" Maximum="100" 
                                         Foreground="#F59E0B" Background="#27272A" BorderThickness="0" Margin="0,2,0,4"/>
                            <Grid Grid.Row="1">
                                <TextBlock Text="{Binding Esp32FlashStatusStep}" FontSize="9" Foreground="#A1A1AA" HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding Esp32FlashProgress, StringFormat=进度: {0}%}" FontSize="9" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Right"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 右列: 4 路物理通道 MOS 供电控制矩阵 -->
                <Border Grid.Column="2" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="12,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="🔌 CH338X 物理下行通道 MOS 供电开通/隔离控制矩阵 (硬件保护)" FontSize="11" FontWeight="Bold" Foreground="#FAFAFA" Margin="0,0,0,8"/>

                        <UniformGrid Grid.Row="1" Columns="4" Rows="1">
                            <!-- 通道 1: FT2232 -->
                            <Border Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="5" Padding="6" Margin="0,0,4,0">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="通道 #1: FT2232" FontSize="9" FontWeight="Bold" Foreground="#FAFAFA" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="JTAG/串口" FontSize="8" Foreground="#71717A" Margin="0,1,0,4"/>
                                    <Button Style="{StaticResource IndustrialBtnStyle}" Height="20" Padding="2,0" FontSize="9"
                                            Command="{Binding ToggleChannelPowerCommand}" CommandParameter="1">
                                        <TextBlock Text="{Binding IsChannel1PowerOn, StringFormat='MOS: {0}'}"/>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- 通道 2: DAPLink -->
                            <Border Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="5" Padding="6" Margin="2,0,2,0">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="通道 #2: DAPLink" FontSize="9" FontWeight="Bold" Foreground="#FAFAFA" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="CMSIS-DAP" FontSize="8" Foreground="#71717A" Margin="0,1,0,4"/>
                                    <Button Style="{StaticResource IndustrialBtnStyle}" Height="20" Padding="2,0" FontSize="9"
                                            Command="{Binding ToggleChannelPowerCommand}" CommandParameter="2">
                                        <TextBlock Text="{Binding IsChannel2PowerOn, StringFormat='MOS: {0}'}"/>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- 通道 3: XDS110 -->
                            <Border Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="5" Padding="6" Margin="2,0,2,0">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="通道 #3: XDS110" FontSize="9" FontWeight="Bold" Foreground="#FAFAFA" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="TI 仿真探针" FontSize="8" Foreground="#71717A" Margin="0,1,0,4"/>
                                    <Button Style="{StaticResource IndustrialBtnStyle}" Height="20" Padding="2,0" FontSize="9"
                                            Command="{Binding ToggleChannelPowerCommand}" CommandParameter="3">
                                        <TextBlock Text="{Binding IsChannel3PowerOn, StringFormat='MOS: {0}'}"/>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- 通道 4: CH343P -->
                            <Border Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="5" Padding="6" Margin="4,0,0,0">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="通道 #4: CH343P" FontSize="9" FontWeight="Bold" Foreground="#FAFAFA" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="虚拟串口/CLI" FontSize="8" Foreground="#71717A" Margin="0,1,0,4"/>
                                    <Button Style="{StaticResource IndustrialBtnStyle}" Height="20" Padding="2,0" FontSize="9"
                                            Command="{Binding ToggleChannelPowerCommand}" CommandParameter="4">
                                        <TextBlock Text="{Binding IsChannel4PowerOn, StringFormat='MOS: {0}'}"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- 行 2: 虚拟接入功能与核心引擎测试工作台 (用来测试里面的功能) -->
            <Border Grid.Row="2" Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- 虚拟接入开关总控栏 -->
                        <RowDefinition Height="Auto" />
                        <!-- 弹出的 4 个虚拟核心设备卡片 (开启后弹出) -->
                        <RowDefinition Height="Auto" />
                        <!-- 选定虚拟设备的完整功能测试工作台 -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 虚拟接入总控栏 -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M 12 2 L 2 7 L 12 12 L 22 7 Z M 2 17 L 12 22 L 22 17 M 2 12 L 12 17 L 22 12" 
                                  Stroke="{StaticResource AccentCyanBrush}" StrokeThickness="1.8" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="🧪 虚拟接入功能 (Virtual Simulation Hub)" FontSize="12" FontWeight="Bold" Foreground="#FAFAFA" VerticalAlignment="Center"/>
                            <Border Background="#1C180B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="3" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding VirtualDevicesStatusText}" FontSize="9" Foreground="#A1A1AA" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <Button Style="{StaticResource AccentActionBtnStyle}" Height="26" Padding="12,0" FontSize="11" HorizontalAlignment="Right"
                                Command="{Binding ToggleVirtualDevicesCommand}" Content="{Binding VirtualDevicesButtonText}"/>
                    </Grid>

                    <!-- 开启后弹出的虚拟设备卡片 (FT2232, CH343P, XDS110, DAP) -->
                    <Border Grid.Row="1" Visibility="{Binding IsVirtualDevicesEnabled, Converter={StaticResource BoolToVisConverter}}" Margin="0,0,0,8">
                        <ItemsControl ItemsSource="{Binding VirtualDevices}" ItemTemplate="{StaticResource DeviceCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Border>

                    <!-- 当虚拟接入关闭时的占位引导提示 -->
                    <Border Grid.Row="2" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="20"
                            Visibility="{Binding IsVirtualDevicesDisabled, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Path Data="M 12 2 C 6.48 2 2 6.48 2 12 C 2 17.52 6.48 22 12 22 C 17.52 22 22 17.52 22 12 C 22 6.48 17.52 2 12 2 Z M 13 17 H 11 V 15 H 13 V 17 Z M 13 13 H 11 V 7 H 13 V 13 Z"
                                  Fill="#71717A" Width="36" Height="36" Stretch="Uniform" Margin="0,0,0,14" HorizontalAlignment="Center"/>
                            <TextBlock Text="虚拟硬件链路未开启" FontSize="14" FontWeight="Bold" Foreground="#FAFAFA" HorizontalAlignment="Center"/>
                            <TextBlock Text="点击右上角【🚀 开启虚拟硬件接入】按钮，系统将立即弹出虚拟的 FT2232、CH343P、XDS110、DAP 仿真设备，" FontSize="11" Foreground="#A1A1AA" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            <TextBlock Text="您可免接物理硬件，直接在此测试固件拖拽烧录、Flash 扇区 Hex 转储、整片擦除、CoreID 抓取、串口通信与 Linux CLI 控制台交互等全部核心功能。" FontSize="11" Foreground="#71717A" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 当虚拟接入开启时展开的功能测试工作台 (用来测试里面的功能) -->
                    <Border Grid.Row="2" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="10"
                            Visibility="{Binding IsVirtualDevicesEnabled, Converter={StaticResource BoolToVisConverter}}">
                        <Grid>
                            <!-- A. 虚拟烧录设备测试 (FT2232 / DAPLink / XDS110，带垂直滚动支持) -->
                            <ScrollViewer Visibility="{Binding IsBurnerWorkspaceVisible, Converter={StaticResource BoolToVisConverter}}"
                                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <Grid Margin="0,0,6,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                <!-- 行 0: 设备标题与内核运行状态 -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="M 13 2 L 3 14 H 12 L 11 22 L 21 10 H 12 L 13 2 Z" Fill="#38BDF8" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding SelectedDevice.DeviceName, StringFormat=测试台：{0}}" 
                                                   FontSize="12" FontWeight="Bold" Foreground="#FAFAFA" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <Border Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding KernelStateText}" FontSize="9" FontFamily="Consolas" Foreground="#34D399"/>
                                    </Border>
                                </Grid>

                                <!-- 行 1: 固件文件放入区 -->
                                <Border Grid.Row="1" Background="#121215" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="5" Padding="10,6" Margin="0,0,0,8"
                                        AllowDrop="True" Drop="FileDropZone_Drop" DragOver="FileDropZone_DragOver">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📂 固件镜像:" FontSize="9" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding CurrentLoadedFile.FileName}" FontSize="10" FontWeight="Bold" Foreground="#FAFAFA" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="大小: " FontSize="9" Foreground="#71717A"/>
                                                <TextBlock Text="{Binding CurrentLoadedFile.FileSizeText}" FontSize="9" Foreground="#A1A1AA" Margin="0,0,8,0"/>
                                                <TextBlock Text="CRC32: " FontSize="9" Foreground="#71717A"/>
                                                <TextBlock Text="{Binding CurrentLoadedFile.Crc32Text}" FontFamily="Consolas" FontSize="9" Foreground="#38BDF8" Margin="0,0,8,0"/>
                                                <TextBlock Text="匹配架构: " FontSize="9" Foreground="#71717A"/>
                                                <TextBlock Text="{Binding CurrentLoadedFile.TargetChipFamily}" FontSize="9" Foreground="#10B981"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                                            <TextBlock Text="烧录基地址: " FontSize="9" Foreground="#71717A" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding LoadBaseAddress, UpdateSourceTrigger=PropertyChanged}" Width="80" Height="22"
                                                     Background="#18181B" Foreground="#38BDF8" BorderBrush="#27272A" FontFamily="Consolas" FontSize="9" Padding="4,2" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <Button Grid.Column="2" Style="{StaticResource IndustrialBtnStyle}" Content="浏览放入固件..." Height="24" Padding="8,1" FontSize="10"
                                                Command="{Binding BrowseFileCommand}"/>
                                    </Grid>
                                </Border>

                                <!-- 行 2: 内核操作组件工具栏 -->
                                <Border Grid.Row="2" Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="5" Padding="6,4" Margin="0,0,0,8">
                                    <WrapPanel VerticalAlignment="Center">
                                        <Button Style="{StaticResource AccentActionBtnStyle}" Content="▶ 开始执行固件烧录" Height="24" Padding="10,0" FontSize="10" Margin="0,0,6,0"
                                                Command="{Binding StartPreviewFlashCommand}" ToolTip="执行流式写入、扇区擦除与片上 CRC32 严格校验"/>
                                        <Button Style="{StaticResource IndustrialBtnStyle}" Content="📖 读取扇区数据 (Read Sector)" Height="24" Padding="8,0" FontSize="10" Margin="0,0,6,0"
                                                Command="{Binding ReadSectorCommand}" ToolTip="从目标 MCU 基地址读取 256 字节并在下方 Hex 转储视窗呈现"/>
                                        <Button Style="{StaticResource IndustrialBtnStyle}" Content="🧹 整片快速擦除 (Chip Erase)" Height="24" Padding="8,0" FontSize="10" Margin="0,0,6,0"
                                                Command="{Binding ChipEraseCommand}" ToolTip="执行全片扇区擦除并校验空片"/>
                                        <Button Style="{StaticResource IndustrialBtnStyle}" Content="⚡ 读取芯片 CoreID" Height="24" Padding="8,0" FontSize="10" Margin="0,0,6,0"
                                                Command="{Binding ReadCoreIdCommand}" ToolTip="在线查询目标 MCU 内核 CoreID 寄存器"/>
                                        <Button Style="{StaticResource IndustrialBtnStyle}" Content="🔄 硬件/系统复位 (SYSRESET)" Height="24" Padding="8,0" FontSize="10"
                                                Command="{Binding ResetTargetCommand}" ToolTip="拉低复位引脚或触发内核 SYSRESETREQ"/>
                                    </WrapPanel>
                                </Border>

                                <!-- 行 3: 烧录进度与速率反馈 -->
                                <Grid Grid.Row="3" Margin="0,0,0,6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <ProgressBar Grid.Row="0" Height="4" Value="{Binding FlashProgress}" Minimum="0" Maximum="100" 
                                                 Foreground="#38BDF8" Background="#27272A" BorderThickness="0" Margin="0,0,0,3"/>
                                    <Grid Grid.Row="1">
                                        <TextBlock Text="{Binding FlashStatusStep}" FontSize="9" Foreground="#A1A1AA" HorizontalAlignment="Left"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding FlashSpeedText, StringFormat=传输速率: {0}}" FontSize="9" Foreground="#38BDF8" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding FlashProgress, StringFormat=进度: {0}%}" FontSize="9" FontWeight="Bold" Foreground="#10B981"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>

                                <!-- 行 4: 扇区 Hex 转储与事件流 -->
                                <Grid Grid.Row="4" Height="220" Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="#0C0C0E" BorderBrush="#27272A" BorderThickness="1" CornerRadius="5" Padding="6">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="Flash 存储扇区 Hex Dump 数据转储 (前 256 字节)" FontSize="9" FontWeight="Bold" Foreground="#FAFAFA" Margin="0,0,0,4"/>
                                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding SectorHexDumpLines}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="10" Foreground="#38BDF8" Margin="0,1"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="2" Background="#0C0C0E" BorderBrush="#27272A" BorderThickness="1" CornerRadius="5" Padding="6">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="内核操作流水线与状态日志" FontSize="9" FontWeight="Bold" Foreground="#FAFAFA" Margin="0,0,0,4"/>
                                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding Logs}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Message}" FontFamily="Consolas" FontSize="10" Foreground="#A1A1AA" Margin="0,1"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                            </ScrollViewer>

                            <!-- B. 虚拟串口与 Linux CLI 调试测试 (CH343P) -->
                            <Grid Visibility="{Binding IsUartWorkspaceVisible, Converter={StaticResource BoolToVisConverter}}">
                                <Grid.RowDefinitions>
                                    <!-- 行 0: 串口参数、DTR/RTS/CTS 硬件引脚与工作台视窗模式 -->
                                    <RowDefinition Height="Auto" />
                                    <!-- 行 1: 智能分流工作区 (Linux CLI 终端 + 串口数据监视) -->
                                    <RowDefinition Height="*" />
                                    <!-- 行 2: 智能自动识别输入条 (自动识别 Linux CLI / HEX / AT / 字符串) -->
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- 行 0: 串口参数工具栏与硬件引脚控制 -->
                                <Border Grid.Row="0" Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="5" Padding="8,5" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 左侧: 端口、波特率、串口开关、硬件引脚 (DTR/RTS/CTS/DSR/Reset) -->
                                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="通信端口: " FontSize="9" Foreground="#71717A" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding SelectedDevice.ComPort}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                            <TextBlock Text="波特率: " FontSize="9" Foreground="#71717A" VerticalAlignment="Center"/>
                                            <ComboBox ItemsSource="{Binding AvailableBaudRates}" SelectedItem="{Binding SelectedBaudRate}" 
                                                      Width="80" Height="22" FontSize="9" Margin="0,0,10,0" VerticalAlignment="Center"/>

                                            <Border Background="#27272A" CornerRadius="3" Padding="5,1" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="8 - None - 1" FontSize="9" Foreground="#A1A1AA"/>
                                            </Border>

                                            <Button Content="{Binding PortOpenButtonText}" Height="22" Padding="8,0" FontSize="9" Margin="0,0,10,0"
                                                    Command="{Binding ToggleSerialPortCommand}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource IndustrialBtnStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPortOpen}" Value="True">
                                                                <Setter Property="Background" Value="#064E3B" />
                                                                <Setter Property="BorderBrush" Value="#10B981" />
                                                                <Setter Property="Foreground" Value="#34D399" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <!-- 硬件控制引脚: DTR 开关 -->
                                            <Button Command="{Binding ToggleDtrCommand}" Height="22" Padding="6,0" FontSize="9" Margin="0,0,5,0"
                                                    ToolTip="切换 DTR (Data Terminal Ready) 输出引脚状态">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource IndustrialBtnStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDtrEnable}" Value="True">
                                                                <Setter Property="Background" Value="#064E3B" />
                                                                <Setter Property="BorderBrush" Value="#10B981" />
                                                                <Setter Property="Foreground" Value="#34D399" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <TextBlock Text="{Binding DtrButtonText}"/>
                                            </Button>

                                            <!-- 硬件控制引脚: RTS 开关 -->
                                            <Button Command="{Binding ToggleRtsCommand}" Height="22" Padding="6,0" FontSize="9" Margin="0,0,5,0"
                                                    ToolTip="切换 RTS (Request To Send) 输出引脚状态">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource IndustrialBtnStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRtsEnable}" Value="True">
                                                                <Setter Property="Background" Value="#064E3B" />
                                                                <Setter Property="BorderBrush" Value="#10B981" />
                                                                <Setter Property="Foreground" Value="#34D399" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <TextBlock Text="{Binding RtsButtonText}"/>
                                            </Button>

                                            <!-- CTS 硬件状态指示 -->
                                            <Border Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,5,0" VerticalAlignment="Center" ToolTip="CTS (Clear To Send) 硬件握手就绪指示">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="5" Height="5" Fill="#10B981" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="CTS" FontSize="8" FontWeight="Bold" Foreground="#A1A1AA"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- DSR / DTS 硬件状态指示 -->
                                            <Border Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="DSR / DTS (Data Set Ready) 硬件载波状态指示">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="5" Height="5" Fill="#10B981" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="DSR(DTS)" FontSize="8" FontWeight="Bold" Foreground="#A1A1AA"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- 硬件复位脉冲 -->
                                            <Button Style="{StaticResource IndustrialBtnStyle}" Content="⚡ DTR/RTS 脉冲复位" Height="22" Padding="6,0" FontSize="9"
                                                    Command="{Binding TriggerMcuResetCommand}" ToolTip="执行 DTR/RTS 硬件时序脉冲复位下位机/开发板 (ESP32/STM32)"/>
                                        </WrapPanel>

                                        <!-- 右侧: 视窗布局切换 (智能双视窗 / 纯 CLI / 纯串口监视) -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource IndustrialBtnStyle}" Content="🤖 智能双视窗" Height="20" Padding="5,0" FontSize="8" Margin="0,0,3,0"
                                                    Command="{Binding SetSerialViewModeCommand}" CommandParameter="0"/>
                                            <Button Style="{StaticResource IndustrialBtnStyle}" Content="🐧 纯 CLI" Height="20" Padding="5,0" FontSize="8" Margin="0,0,3,0"
                                                    Command="{Binding SetSerialViewModeCommand}" CommandParameter="1"/>
                                            <Button Style="{StaticResource IndustrialBtnStyle}" Content="📡 纯串口监视" Height="20" Padding="5,0" FontSize="8"
                                                    Command="{Binding SetSerialViewModeCommand}" CommandParameter="2"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- 行 1: 智能分流工作区 (Linux CLI 终端 + 串口数据监视) -->
                                <Grid Grid.Row="1" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <!-- 左列: Linux CLI 终端 -->
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="6" />
                                        <!-- 右列: 串口数据与 HEX 监视器 -->
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 左列: 🐧 Linux 卡片机 CLI 交互终端 -->
                                    <Grid Grid.Column="0" Visibility="{Binding IsLinuxCliAreaVisible, Converter={StaticResource BoolToVisConverter}}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <!-- 快捷命令注入条 -->
                                        <WrapPanel Grid.Row="0" Margin="0,0,0,4">
                                            <TextBlock Text="快捷注入:" FontSize="8" Foreground="#71717A" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <Button Style="{StaticResource IndustrialBtnStyle}" Content="uname -a" Height="18" Padding="4,0" FontSize="8" Margin="0,0,3,2" Command="{Binding InjectCliPresetCommand}" CommandParameter="uname -a"/>
                                            <Button Style="{StaticResource IndustrialBtnStyle}" Content="ifconfig -a" Height="18" Padding="4,0" FontSize="8" Margin="0,0,3,2" Command="{Binding InjectCliPresetCommand}" CommandParameter="ifconfig -a"/>
                                            <Button Style="{StaticResource IndustrialBtnStyle}" Content="dmesg | tail" Height="18" Padding="4,0" FontSize="8" Margin="0,0,3,2" Command="{Binding InjectCliPresetCommand}" CommandParameter="dmesg | tail -n 20"/>
                                            <Button Style="{StaticResource IndustrialBtnStyle}" Content="top (负载)" Height="18" Padding="4,0" FontSize="8" Margin="0,0,3,2" Command="{Binding InjectCliPresetCommand}" CommandParameter="top -b -n 1"/>
                                            <Button Style="{StaticResource IndustrialBtnStyle}" Content="reboot" Height="18" Padding="4,0" FontSize="8" Margin="0,0,3,2" Command="{Binding InjectCliPresetCommand}" CommandParameter="reboot"/>
                                            <Button Style="{StaticResource IndustrialBtnStyle}" Content="clear" Height="18" Padding="4,0" FontSize="8" Margin="0,0,3,2" Command="{Binding InjectCliPresetCommand}" CommandParameter="clear"/>
                                        </WrapPanel>

                                        <!-- Linux 终端显示区 -->
                                        <Border Grid.Row="1" Background="#0C0C0E" BorderBrush="#27272A" BorderThickness="1" CornerRadius="4" Padding="6">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding LinuxCliTerminalLines}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="10" Foreground="#38BDF8" Margin="0,1" TextWrapping="Wrap"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>

                                    <!-- 分割栏 (仅在双视窗模式时显示) -->
                                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#18181B" 
                                                  Visibility="{Binding IsSmartDualViewVisible, Converter={StaticResource BoolToVisConverter}}"/>

                                    <!-- 右列: 📡 实时串口数据监视与 HEX 分析器 -->
                                    <Border Grid.Column="2" Background="#0C0C0E" BorderBrush="#27272A" BorderThickness="1" CornerRadius="4" Padding="6"
                                            Visibility="{Binding IsSerialMonitorAreaVisible, Converter={StaticResource BoolToVisConverter}}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <!-- 监视器控制栏 -->
                                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="数据接收监视 (Rx)" FontSize="9" FontWeight="Bold" Foreground="#FAFAFA" VerticalAlignment="Center"/>
                                                    <CheckBox Content="HEX" IsChecked="{Binding IsHexReceiveMode}" Foreground="#71717A" FontSize="8" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                    <CheckBox Content="时间戳" IsChecked="{Binding IsTimestampEnabled}" Foreground="#71717A" FontSize="8" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SerialTxBytes, StringFormat=TX: {0}B}" FontSize="8" Foreground="#71717A" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding SerialRxBytes, StringFormat=RX: {0}B}" FontSize="8" Foreground="#10B981" Margin="0,0,4,0"/>
                                                    <Button Style="{StaticResource IndustrialBtnStyle}" Content="清空" Height="16" Padding="4,0" FontSize="8" 
                                                            Command="{Binding ClearSerialMonitorCommand}"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- 串口数据行 -->
                                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding SerialMonitorLines}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="9" Foreground="#34D399" Margin="0,1" TextWrapping="Wrap"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- 行 2: 智能自动识别输入条 (自动识别 Linux CLI / HEX / AT / 字符串) -->
                                <Border Grid.Row="2" Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="4" Padding="6,4">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- 自动识别分类指示标签 -->
                                        <Grid Grid.Row="0" Margin="0,0,0,3">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border BorderBrush="{Binding DetectedInputBadgeColor}" BorderThickness="1" CornerRadius="2" Padding="4,1" Background="#18181B">
                                                    <TextBlock Text="{Binding DetectedInputType}" FontSize="8" FontWeight="Bold" Foreground="{Binding DetectedInputBadgeColor}"/>
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="模式锁定:" FontSize="8" Foreground="#71717A" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <RadioButton Content="🤖 智能自适应" IsChecked="True" Foreground="#FAFAFA" FontSize="8" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <CheckBox Content="追加 \r\n" IsChecked="{Binding IsAppendNewLine}" Foreground="#71717A" FontSize="8" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- 智能输入交互行 -->
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="root@linknexus-board:~# " FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center" Margin="2,0,3,0"/>
                                            <TextBox Grid.Column="1" Text="{Binding SmartInputBuffer, UpdateSourceTrigger=PropertyChanged}" 
                                                     KeyDown="SmartInputTextBox_KeyDown"
                                                     Height="22" Background="#18181B" Foreground="#FAFAFA" BorderBrush="#27272A" BorderThickness="1" 
                                                     FontFamily="Consolas" FontSize="10" Padding="4,2" VerticalAlignment="Center"/>
                                            <Button Grid.Column="2" Style="{StaticResource AccentActionBtnStyle}" Content="▶ 执行 / 发送 (Enter)" Height="22" Padding="10,0" FontSize="9" Margin="4,0,0,0"
                                                    Command="{Binding SendSmartInputCommand}" ToolTip="自动按识别到的类型发送 (支持直接按回车键)"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>

        <!-- ========================================================= -->
        <!-- 3. 底部状态与版本号条 (左下角 ESP32 守护服务三态，右下角 5 次暗门) -->
        <!-- ========================================================= -->
        <Border Grid.Row="2" Background="#121215" BorderBrush="#27272A" BorderThickness="0,1,0,0" Padding="14,0">
            <Grid>
                <!-- 左下角: LinkNexus 物理拓扑守护服务状态 (ESP32 隐藏驱动：绿/红/黄) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Ellipse Width="7" Height="7" Fill="{Binding DaemonStatusDotColor}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding DaemonStatusText}" FontSize="11" Foreground="#A1A1AA" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 右下角: 规范工程版本号 (1.5秒内连续点击5次触发开发者模式，无其他入口) -->
                <Button Style="{StaticResource CaptionBtnStyle}" Height="24" Width="Auto" Padding="8,0" HorizontalAlignment="Right"
                        Command="{Binding VersionClickCommand}" 
                        ToolTip="工程规范版本号：vXXxx.YYWW (XXX) | 连续点击 5 次切换开发者维护模式">
                    <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="4" Padding="7,2">
                        <TextBlock Text="{Binding VersionString}" FontFamily="Consolas, Segoe UI" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                    </Border>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
