<UserControl x:Class="LinkNexus.Blueprint.Controls.ScottPlotOscilloscopeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="600"
             Background="#0B0F17">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Path Data="M3,17 L7,11 L11,15 L15,6 L19,12 L21,9 M3,20 H21"
                          Stroke="#38BDF8" StrokeThickness="2" Width="18" Height="18" Margin="0,0,8,0" Stretch="Uniform" />
                    <TextBlock Text="ScottPlot 高性能实时示波器" Foreground="#F3F4F6" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                    <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                        <TextBlock x:Name="StatusBadge" Text="硬件加速 Skia 渲染 · 60 FPS" Foreground="#38BDF8" FontSize="11" />
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnAutoFit" Content="自适应量程" Click="BtnAutoFit_Click"
                            Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#334155" BorderThickness="1"
                            Padding="10,4" Margin="0,0,8,0" Cursor="Hand" />
                    <Button x:Name="BtnPause" Content="冻结波形" Click="BtnPause_Click"
                            Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#334155" BorderThickness="1"
                            Padding="10,4" Margin="0,0,8,0" Cursor="Hand" />
                    <Button x:Name="BtnClear" Content="清空缓存" Click="BtnClear_Click"
                            Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#334155" BorderThickness="1"
                            Padding="10,4" Cursor="Hand" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ScottPlot 绘图核心区 -->
        <sp:WpfPlot x:Name="ScopePlot" Grid.Row="1" />

        <!-- 底部通道数值读数条 -->
        <Border Grid.Row="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="12,6">
            <TextBlock x:Name="TxtReadout" Text="CH0: -- | CH1: -- | CH2: -- | 等待数据流接入..."
                       Foreground="#94A3B8" FontSize="11" FontFamily="Consolas, monospace" VerticalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>

