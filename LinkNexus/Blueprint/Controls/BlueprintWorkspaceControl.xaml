<UserControl x:Class="LinkNexus.Blueprint.Controls.BlueprintWorkspaceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:LinkNexus.Blueprint.Controls"
             xmlns:core="clr-namespace:LinkNexus.Blueprint.Core"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             Focusable="True"
             PreviewKeyDown="Workspace_PreviewKeyDown">
    <UserControl.Resources>
        <Style x:Key="PaletteBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource IndustrialBtnBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource IndustrialBtnBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource IndustrialBtnHoverBgBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentCyanBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RunPrimaryBtnStyle" TargetType="Button" BasedOn="{StaticResource PaletteBtnStyle}">
            <Setter Property="BorderBrush" Value="{DynamicResource SuccessGreenBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SuccessGreenBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource AppBgBrush}">
        <Grid.RowDefinitions>
            <!-- 0: 中央无遮挡全尺寸画布 (最大化视野，顶部工具栏已全量精简，控件悬浮右下角) -->
            <RowDefinition Height="*" />
            <!-- 1: 底部流式管道遥测与图例栏 -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0. 中部大尺寸三阶贝塞尔蓝图主画布 (4200x2800，鼠标滚轮自由缩放、空白区拖拽平移、磁吸连线、右下角悬浮 HUD) -->
        <Grid Grid.Row="0">
            <ScrollViewer x:Name="StageScrollViewer"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          PanningMode="Both"
                          PreviewMouseWheel="StageScrollViewer_PreviewMouseWheel">
                <Grid x:Name="BlueprintStageGrid"
                      Width="4200"
                      Height="2800"
                      Background="Transparent"
                      MouseMove="Stage_MouseMove"
                      MouseLeftButtonUp="Stage_MouseLeftButtonUp"
                      MouseLeftButtonDown="Stage_MouseLeftButtonDown"
                      MouseRightButtonUp="Stage_MouseRightButtonUp">
                    <Grid.LayoutTransform>
                        <ScaleTransform x:Name="StageScaleTransform" ScaleX="1.0" ScaleY="1.0" />
                    </Grid.LayoutTransform>

                    <!-- 底层：工程点阵底图 + 已绑定的三阶贝塞尔数据流连线 -->
                    <ctrl:BezierWireCanvas x:Name="UnderlayWireCanvas"
                                           Connections="{Binding Connections}"
                                           ShowBackgroundGrid="True"
                                           RenderEstablishedConnections="True" />

                    <!-- 中层：自由坐标节点卡片容器 -->
                    <ItemsControl x:Name="NodesItemsControl"
                                  ItemsSource="{Binding Nodes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas IsItemsHost="True" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X, Mode=TwoWay}" />
                                <Setter Property="Canvas.Top" Value="{Binding Y, Mode=TwoWay}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type core:NodeBase}">
                                <ctrl:NodeCardControl />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 顶层：跨卡片无遮挡实时拖拽贝塞尔预览曲线与磁吸光环 -->
                    <ctrl:BezierWireCanvas x:Name="OverlayPreviewCanvas"
                                           IsHitTestVisible="False"
                                           ShowBackgroundGrid="False"
                                           RenderEstablishedConnections="False" />
                </Grid>
            </ScrollViewer>

            <!-- 右下角悬浮 HUD 快速控制胶囊 (放大/缩小/100%、启动全部源、停止全部、自动排版、清空连线与快捷键徽章) -->
            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,24,24"
                    Background="#D9181E29"
                    BorderBrush="#38BDF8"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="8,5"
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.55" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 快捷操作徽章 -->
                    <Border Background="#1E293B" CornerRadius="4" Padding="7,3" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="快捷键操作指引">
                        <TextBlock FontSize="10.5" Foreground="#94A3B8" FontFamily="Consolas">
                            <Run Text="💡" />
                            <Run Text="Shift+A" FontWeight="Bold" Foreground="#38BDF8" />
                            <Run Text=" / 右键 新建节点" />
                        </TextBlock>
                    </Border>

                    <Border Width="1" Height="14" Background="{DynamicResource AppBorderBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />

                    <!-- 画布缩放按钮 -->
                    <Button Click="ZoomOutBtn_Click"
                            Content="−"
                            Padding="8,3"
                            Margin="0,0,3,0"
                            ToolTip="缩小蓝图画布 (也可直接在画布上滚动滚轮)"
                            Style="{StaticResource PaletteBtnStyle}" />
                    <Button x:Name="ZoomResetBtn"
                            Click="ZoomResetBtn_Click"
                            Content="100%"
                            FontFamily="Consolas"
                            Padding="8,3"
                            Margin="0,0,3,0"
                            ToolTip="重置画布缩放至 100% (鼠标滚轮可自由缩放 35% ~ 240%)"
                            Style="{StaticResource PaletteBtnStyle}" />
                    <Button Click="ZoomInBtn_Click"
                            Content="+"
                            Padding="8,3"
                            Margin="0,0,8,0"
                            ToolTip="放大蓝图画布 (也可直接在画布上滚动滚轮)"
                            Style="{StaticResource PaletteBtnStyle}" />

                    <Border Width="1" Height="14" Background="{DynamicResource AppBorderBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />

                    <!-- 启动全部源 -->
                    <Button Command="{Binding StartAllStreamsCommand}"
                            Style="{StaticResource RunPrimaryBtnStyle}"
                            Padding="10,4"
                            Margin="0,0,4,0"
                            ToolTip="启动画布上已指定真实 USB 端口的全部硬件流采集源">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M0,0 L8,5 L0,10 Z" Fill="{DynamicResource SuccessGreenBrush}" Width="8" Height="9" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="启动全部源" />
                        </StackPanel>
                    </Button>

                    <!-- 停止全部 -->
                    <Button Command="{Binding StopAllStreamsCommand}"
                            Content="停止全部"
                            Padding="9,4"
                            Margin="0,0,4,0"
                            ToolTip="停止画布上全部流式采集与下发通道"
                            Style="{StaticResource PaletteBtnStyle}" />

                    <!-- 自动排版 -->
                    <Button Command="{Binding AutoLayoutCommand}"
                            Content="自动排版"
                            Padding="8,4"
                            Margin="0,0,4,0"
                            ToolTip="按数据流拓扑层级自动重排画布所有节点"
                            Style="{StaticResource PaletteBtnStyle}" />

                    <!-- 清空连线 -->
                    <Button Command="{Binding ClearAllWiresCommand}"
                            Content="清空连线"
                            Padding="8,4"
                            Margin="0"
                            ToolTip="清除画布上全部数据流连线"
                            Style="{StaticResource PaletteBtnStyle}" />
                </StackPanel>
            </Border>

            <!-- Blender / UE5 风格无边框毛玻璃暗黑搜索与拉线建链弹窗 -->
            <ctrl:NodeSearchPopup x:Name="SearchPopup" />
        </Grid>

        <!-- 1. 底部流式管道遥测与端口类型图例栏 -->
        <Border Grid.Row="1"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,5">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="#38BDF8" Margin="0,0,4,0" VerticalAlignment="Center" />
                    <TextBlock Text="通道向量(CH)" FontSize="10.5" Foreground="{DynamicResource AppTextMutedBrush}" Margin="0,0,10,0" />
                    <Ellipse Width="7" Height="7" Fill="#A78BFA" Margin="0,0,4,0" VerticalAlignment="Center" />
                    <TextBlock Text="空间姿态(IMU)" FontSize="10.5" Foreground="{DynamicResource AppTextMutedBrush}" Margin="0,0,10,0" />
                    <Ellipse Width="7" Height="7" Fill="#34D399" Margin="0,0,4,0" VerticalAlignment="Center" />
                    <TextBlock Text="原始帧(RAW)" FontSize="10.5" Foreground="{DynamicResource AppTextMutedBrush}" Margin="0,0,10,0" />
                    <Ellipse Width="7" Height="7" Fill="#FBBF24" Margin="0,0,4,0" VerticalAlignment="Center" />
                    <TextBlock Text="通用端口(ANY)" FontSize="10.5" Foreground="{DynamicResource AppTextMutedBrush}" Margin="0,0,12,0" />

                    <TextBlock FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource AccentCyanBrush}">
                        <Run Text="缩放:" />
                        <Run Text="{Binding CanvasZoomPercentText, Mode=OneWay}" />
                        <Run Text=" · 节点:" />
                        <Run Text="{Binding NodeCount, Mode=OneWay}" />
                        <Run Text=" · 管道:" />
                        <Run Text="{Binding ConnectionCount, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <TextBlock Text="{Binding WorkspaceHint}"
                           FontSize="11"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
