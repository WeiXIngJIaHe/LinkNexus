<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:nodify="https://miroiu.github.io/nodify"
                    xmlns:pipeline="clr-namespace:LinkNexus.Core.Pipeline"
                    xmlns:local="clr-namespace:LinkNexus">

    <!-- ========================================================= -->
    <!-- 转换器与辅助资源 -->
    <!-- ========================================================= -->
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- ========================================================= -->
    <!-- 工业级 Nodify 端口引脚样式 (NodeInput / NodeOutput) -->
    <!-- ========================================================= -->
    <Style x:Key="HilNodeInputStyle" TargetType="{x:Type nodify:NodeInput}">
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,3" />
        <Setter Property="ConnectorTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Border Width="12" Height="12"
                            CornerRadius="6"
                            Background="{Binding PinBrush}"
                            BorderBrush="#1E293B"
                            BorderThickness="2"
                            ToolTip="{Binding DataType}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HilNodeOutputStyle" TargetType="{x:Type nodify:NodeOutput}">
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,3" />
        <Setter Property="ConnectorTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Border Width="12" Height="12"
                            CornerRadius="6"
                            Background="{Binding PinBrush}"
                            BorderBrush="#1E293B"
                            BorderThickness="2"
                            ToolTip="{Binding DataType}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================================= -->
    <!-- 核心 DAG 算子卡片模板 (Blender / UE5 风格流光 Header + Inline Widget + 60px 微波形) -->
    <!-- ========================================================= -->
    <DataTemplate DataType="{x:Type pipeline:NodeBase}">
        <Border Background="#1E2430"
                BorderBrush="{Binding HeaderAccentBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Width="{Binding CardWidth}"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.45" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <!-- 0: 流光分类 Header (高 36) -->
                    <RowDefinition Height="Auto" />
                    <!-- 1: 节点主体 (引脚、内联参数、60px 示波微视口) -->
                    <RowDefinition Height="*" />
                    <!-- 2: 底部状态与数据流计数 -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 0. Header (带流光色标、矢量图标、标题与角色徽章) -->
                <Border Grid.Row="0"
                        Background="#252D3D"
                        BorderBrush="{DynamicResource AppBorderSubtleBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="7,7,0,0"
                        Padding="10,7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 左侧图标与流光色点 -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{Binding HeaderAccentBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <Path Data="{Binding IconGeometry}"
                                  Fill="{Binding HeaderAccentBrush}"
                                  Width="12" Height="12"
                                  Stretch="Uniform"
                                  Margin="0,0,6,0"
                                  VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- 中间标题与分类 -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}"
                                       FontSize="11.5"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}" />
                            <TextBlock Text="{Binding CategoryName}"
                                       FontSize="9"
                                       Foreground="{DynamicResource AppTextMutedBrush}" />
                        </StackPanel>

                        <!-- 右侧状态标签 -->
                        <Border Grid.Column="2"
                                Background="#1A202C"
                                BorderBrush="{Binding HeaderAccentBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6,2"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusBadge}"
                                       FontSize="9"
                                       FontFamily="Consolas"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding HeaderAccentBrush}" />
                        </Border>
                    </Grid>
                </Border>

                <!-- 1. Body 主体内容区 -->
                <Grid Grid.Row="1" Margin="8,8,8,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 引脚行 (左: InputConnectors, 右: OutputConnectors) -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 输入端口列表 -->
                        <ItemsControl Grid.Column="0"
                                      ItemsSource="{Binding InputConnectors}"
                                      HorizontalAlignment="Left">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type pipeline:ConnectorViewModel}">
                                    <nodify:NodeInput Style="{StaticResource HilNodeInputStyle}"
                                                      Header="{Binding Title}"
                                                      Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                                      IsConnected="{Binding IsConnected}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 输出端口列表 -->
                        <ItemsControl Grid.Column="1"
                                      ItemsSource="{Binding OutputConnectors}"
                                      HorizontalAlignment="Right">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type pipeline:ConnectorViewModel}">
                                    <nodify:NodeOutput Style="{StaticResource HilNodeOutputStyle}"
                                                       Header="{Binding Title}"
                                                       Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                                       IsConnected="{Binding IsConnected}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- 内联参数控件列表 (Inline Widgets: Slider, Text, Toggle, Combo, AI GhostValue) -->
                    <ItemsControl Grid.Row="1"
                                  ItemsSource="{Binding Parameters}"
                                  Margin="2,6,2,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type pipeline:NodeParameter}">
                                <Border Margin="0,3"
                                        Background="#181E29"
                                        BorderBrush="#334155"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="6,4">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="{Binding Label}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                       HorizontalAlignment="Left" />
                                            <!-- GhostValue 幽灵值提示胶囊 -->
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        Visibility="{Binding HasGhostValue, Converter={StaticResource BoolToVis}}">
                                                <Border Background="#3B2A4A"
                                                        BorderBrush="#A855F7"
                                                        BorderThickness="1"
                                                        CornerRadius="3"
                                                        Padding="4,1"
                                                        Margin="0,0,4,0"
                                                        ToolTip="{Binding GhostReason}">
                                                    <TextBlock Text="{Binding GhostValue, StringFormat='AI: {0}'}"
                                                               FontSize="9"
                                                               FontFamily="Consolas"
                                                               Foreground="#E9D5FF" />
                                                </Border>
                                                <!-- 采纳幽灵值按钮 -->
                                                <Button Content="✔"
                                                        FontSize="9"
                                                        Padding="4,0"
                                                        Margin="0,0,2,0"
                                                        Height="16"
                                                        Background="#065F46"
                                                        Foreground="#34D399"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        Command="{Binding AcceptGhostCommand}"
                                                        ToolTip="采纳 AI 调优推荐值" />
                                                <!-- 拒绝幽灵值按钮 -->
                                                <Button Content="✖"
                                                        FontSize="9"
                                                        Padding="4,0"
                                                        Height="16"
                                                        Background="#7F1D1D"
                                                        Foreground="#F87171"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        Command="{Binding RejectGhostCommand}"
                                                        ToolTip="放弃 AI 调优推荐值" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Widget: Slider + Clamp -->
                                        <Grid Margin="0,3,0,0" Visibility="{Binding IsSlider, Converter={StaticResource BoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="48" />
                                            </Grid.ColumnDefinitions>
                                            <Slider Grid.Column="0"
                                                    Minimum="{Binding Min}"
                                                    Maximum="{Binding Max}"
                                                    SmallChange="{Binding Step}"
                                                    LargeChange="{Binding Step}"
                                                    Value="{Binding DoubleValue, Mode=TwoWay}"
                                                    VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Value}"
                                                       FontSize="10"
                                                       FontFamily="Consolas"
                                                       Foreground="{DynamicResource AccentCyanBrush}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Widget: Text / Number / Expression -->
                                        <TextBox Margin="0,3,0,0"
                                                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="10.5"
                                                 FontFamily="Consolas"
                                                 Background="#0F172A"
                                                 Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                 BorderBrush="#475569"
                                                 BorderThickness="1"
                                                 Padding="5,2"
                                                 Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}" />

                                        <!-- Widget: Toggle -->
                                        <Button Margin="0,3,0,0"
                                                Content="{Binding ToggleStateLabel}"
                                                Command="{Binding ActionCommand}"
                                                FontSize="10"
                                                Padding="6,3"
                                                HorizontalAlignment="Stretch"
                                                Style="{DynamicResource IndustrialBtnStyle}"
                                                Visibility="{Binding IsToggle, Converter={StaticResource BoolToVis}}" />

                                        <!-- Widget: ActionButton -->
                                        <Button Margin="0,3,0,0"
                                                Content="{Binding ButtonText}"
                                                Command="{Binding ActionCommand}"
                                                FontSize="10"
                                                Padding="6,3"
                                                HorizontalAlignment="Stretch"
                                                Style="{DynamicResource IndustrialBtnStyle}"
                                                Visibility="{Binding IsActionButton, Converter={StaticResource BoolToVis}}" />

                                        <!-- Widget: Combo (USB Ports / Filters) -->
                                        <ComboBox Margin="0,3,0,0"
                                                  ItemsSource="{Binding Options}"
                                                  SelectedItem="{Binding Value, Mode=TwoWay}"
                                                  FontSize="10"
                                                  FontFamily="Consolas"
                                                  Visibility="{Binding IsCombo, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 60px 内嵌实时微波形视口 (Micro Sparkline Visual) -->
                    <Border Grid.Row="2"
                            Height="48"
                            Margin="2,4,2,2"
                            Background="#111622"
                            BorderBrush="#1E293B"
                            BorderThickness="1"
                            CornerRadius="4"
                            ClipToBounds="True"
                            Visibility="{Binding HasEmbeddedMicroScope, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <!-- 示波背景标尺网格 -->
                            <Path Data="M0,24 H140 M70,0 V48"
                                  Stroke="#1E293B"
                                  StrokeThickness="0.6"
                                  StrokeDashArray="2,2"
                                  Stretch="Fill" />
                            <!-- 动态微波形折线 -->
                            <Polyline Points="{Binding SparklinePoints}"
                                      Stroke="{Binding HeaderAccentBrush}"
                                      StrokeThickness="1.5"
                                      SnapsToDevicePixels="True" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- 2. Footer 底部信息栏 (采样计数与流向) -->
                <Border Grid.Row="2"
                        Background="#1A202C"
                        BorderBrush="{DynamicResource AppBorderSubtleBrush}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,7,7"
                        Padding="8,4">
                    <Grid>
                        <TextBlock Text="{Binding Role, StringFormat='角色: {0}'}"
                                   FontSize="9"
                                   Foreground="{DynamicResource AppTextMutedBrush}"
                                   HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding SampleCounter, StringFormat='数据包: {0:N0}'}"
                                   FontSize="9"
                                   FontFamily="Consolas"
                                   Foreground="{DynamicResource AccentCyanBrush}"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </DataTemplate>

</ResourceDictionary>
