<UserControl x:Class="LinkNexus.Blueprint.Controls.BlueprintWorkspaceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:LinkNexus.Blueprint.Controls"
             xmlns:core="clr-namespace:LinkNexus.Blueprint.Core"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <Style x:Key="PaletteBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource IndustrialBtnBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource IndustrialBtnBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource IndustrialBtnHoverBgBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentCyanBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RunPrimaryBtnStyle" TargetType="Button" BasedOn="{StaticResource PaletteBtnStyle}">
            <Setter Property="BorderBrush" Value="{DynamicResource SuccessGreenBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SuccessGreenBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource AppBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. 顶部节点组件仓库与预设编排工具栏 -->
        <Border Grid.Row="0"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <DockPanel LastChildFill="False">
                <!-- 左侧：七大核心流式卡片生成器 -->
                <WrapPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="添加节点"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextMutedBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />

                    <Button Command="{Binding AddComInputNodeCommand}" Style="{StaticResource PaletteBtnStyle}" ToolTip="新建 COM 串口输入采集卡片">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#0EA5E9" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="+ COM 输入" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding AddComOutputNodeCommand}" Style="{StaticResource PaletteBtnStyle}" ToolTip="新建 COM 串口输出下发卡片">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#10B981" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="+ COM 输出" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding AddMcpInputNodeCommand}" Style="{StaticResource PaletteBtnStyle}" ToolTip="新建 MCP Agent / ESP32 遥测数据输入卡片">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#14B8A6" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="+ MCP 输入" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding AddPythonAlgoNodeCommand}" Style="{StaticResource PaletteBtnStyle}" ToolTip="新建 Python 算法仓库信号解算卡片">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#8B5CF6" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="+ Python 算法" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding AddVofaPlotNodeCommand}" Style="{StaticResource PaletteBtnStyle}" ToolTip="新建 VOFA+ 多通道实时波形示波卡片">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#06B6D4" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="+ VOFA+ 绘图" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding AddImu3DPlotNodeCommand}" Style="{StaticResource PaletteBtnStyle}" ToolTip="新建 IMU 三维空间姿态视窗卡片">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#A855F7" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="+ 三维姿态" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding AddCsvSaveNodeCommand}" Style="{StaticResource PaletteBtnStyle}" ToolTip="新建 CSV 高频刷盘存储卡片">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#F59E0B" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="+ CSV 保存" />
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <!-- 右侧：全局流控与典型拓扑预设 -->
                <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Command="{Binding StartAllStreamsCommand}"
                            Style="{StaticResource RunPrimaryBtnStyle}"
                            ToolTip="一键启动画布上全部数据采集源节点">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M0,0 L8,5 L0,10 Z" Fill="{DynamicResource SuccessGreenBrush}" Width="8" Height="9" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="启动全部源" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding StopAllStreamsCommand}"
                            Content="停止全部"
                            Style="{StaticResource PaletteBtnStyle}" />

                    <Button Command="{Binding ClearAllWiresCommand}"
                            Content="清空连线"
                            Style="{StaticResource PaletteBtnStyle}" />

                    <Border Width="1" Height="16" Background="{DynamicResource AppBorderBrush}" Margin="3,0,8,0" />

                    <TextBlock Text="预设:"
                               FontSize="11"
                               Foreground="{DynamicResource AppTextMutedBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,5,0" />
                    <Button Command="{Binding LoadDualShowcasePresetCommand}" Content="双链全景" Style="{StaticResource PaletteBtnStyle}" ToolTip="载入 VOFA+ 卡尔曼滤波与 IMU 三维姿态双链路全景蓝图" />
                    <Button Command="{Binding LoadVofaFilterPresetCommand}" Content="VOFA+ 示波" Style="{StaticResource PaletteBtnStyle}" ToolTip="载入并自动启动 VOFA+ 实时滤波与 CSV 记录链路" />
                    <Button Command="{Binding LoadImuAttitudePresetCommand}" Content="IMU 姿态" Style="{StaticResource PaletteBtnStyle}" ToolTip="载入并自动启动 IMU 三维姿态与三轴欧拉角同步示波链路" />
                    <Button Command="{Binding LoadMcpTelemetryPresetCommand}" Content="MCP 遥测" Style="{StaticResource PaletteBtnStyle}" Margin="0" ToolTip="载入 MCP Agent 与 ESP32 INA236 实时电气遥测链路" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- 2. 中部无限感三阶贝塞尔蓝图主画布 (支持空白区拖拽平移、磁吸连线、右键断线) -->
        <ScrollViewer x:Name="StageScrollViewer"
                      Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      PanningMode="Both">
            <Grid x:Name="BlueprintStageGrid"
                  Width="1960"
                  Height="1180"
                  Background="Transparent"
                  MouseMove="Stage_MouseMove"
                  MouseLeftButtonUp="Stage_MouseLeftButtonUp"
                  MouseLeftButtonDown="Stage_MouseLeftButtonDown">

                <!-- 底层：工程点阵底图 + 已绑定的三阶贝塞尔数据流连线 -->
                <ctrl:BezierWireCanvas x:Name="UnderlayWireCanvas"
                                       Connections="{Binding Connections}"
                                       ShowBackgroundGrid="True"
                                       RenderEstablishedConnections="True" />

                <!-- 中层：自由坐标节点卡片容器 -->
                <ItemsControl x:Name="NodesItemsControl"
                              ItemsSource="{Binding Nodes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas IsItemsHost="True" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X, Mode=TwoWay}" />
                            <Setter Property="Canvas.Top" Value="{Binding Y, Mode=TwoWay}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type core:NodeBase}">
                            <ctrl:NodeCardControl />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 顶层：跨卡片无遮挡实时拖拽贝塞尔预览曲线与磁吸光环 -->
                <ctrl:BezierWireCanvas x:Name="OverlayPreviewCanvas"
                                       IsHitTestVisible="False"
                                       ShowBackgroundGrid="False"
                                       RenderEstablishedConnections="False" />
            </Grid>
        </ScrollViewer>

        <!-- 3. 底部流式管道遥测与端口类型图例栏 -->
        <Border Grid.Row="2"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,5">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="#38BDF8" Margin="0,0,4,0" VerticalAlignment="Center" />
                    <TextBlock Text="通道向量(CH)" FontSize="10.5" Foreground="{DynamicResource AppTextMutedBrush}" Margin="0,0,10,0" />
                    <Ellipse Width="7" Height="7" Fill="#A78BFA" Margin="0,0,4,0" VerticalAlignment="Center" />
                    <TextBlock Text="空间姿态(IMU)" FontSize="10.5" Foreground="{DynamicResource AppTextMutedBrush}" Margin="0,0,10,0" />
                    <Ellipse Width="7" Height="7" Fill="#34D399" Margin="0,0,4,0" VerticalAlignment="Center" />
                    <TextBlock Text="原始帧(RAW)" FontSize="10.5" Foreground="{DynamicResource AppTextMutedBrush}" Margin="0,0,10,0" />
                    <Ellipse Width="7" Height="7" Fill="#FBBF24" Margin="0,0,4,0" VerticalAlignment="Center" />
                    <TextBlock Text="通用端口(ANY)" FontSize="10.5" Foreground="{DynamicResource AppTextMutedBrush}" Margin="0,0,12,0" />

                    <TextBlock FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource AccentCyanBrush}">
                        <Run Text="节点:" />
                        <Run Text="{Binding NodeCount, Mode=OneWay}" />
                        <Run Text=" · 管道:" />
                        <Run Text="{Binding ConnectionCount, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <TextBlock Text="{Binding WorkspaceHint}"
                           FontSize="11"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
