<Window x:Class="LinkNexus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LinkNexus"
        mc:Ignorable="d"
        Title="LinkNexus - 多协议桌面硬件调试站"
        Height="880" Width="1440"
        MinHeight="720" MinWidth="1180"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#18181B"
        Foreground="#FAFAFA"
        FontFamily="Microsoft YaHei, Segoe UI, PingFang SC"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <!-- 沉浸式隐形标题栏 (WindowChrome) -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" 
                      GlassFrameThickness="0" 
                      CornerRadius="0" 
                      ResizeBorderThickness="6" 
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- 全局样式与调色板资源 -->
    <Window.Resources>
        <!-- 工业暗黑调色板 -->
        <SolidColorBrush x:Key="BgDarkBrush" Color="#18181B" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#121215" />
        <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#1A1A20" />
        <SolidColorBrush x:Key="BorderDarkBrush" Color="#27272A" />
        <SolidColorBrush x:Key="BorderLightBrush" Color="#3F3F46" />

        <!-- 科技状态色 -->
        <SolidColorBrush x:Key="AccentCyanBrush" Color="#38BDF8" />
        <SolidColorBrush x:Key="SuccessGreenBrush" Color="#10B981" />
        <SolidColorBrush x:Key="WarningAmberBrush" Color="#F59E0B" />
        <SolidColorBrush x:Key="ErrorRedBrush" Color="#EF4444" />
        <SolidColorBrush x:Key="TextDimBrush" Color="#71717A" />
        <SolidColorBrush x:Key="TextNormalBrush" Color="#D4D4D8" />
        <SolidColorBrush x:Key="TextBrightBrush" Color="#FAFAFA" />

        <!-- 标题栏通用控制按钮样式 -->
        <Style x:Key="CaptionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#27272A" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#18181B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 标题栏关闭按钮样式 -->
        <Style x:Key="CaptionCloseBtnStyle" TargetType="Button" BasedOn="{StaticResource CaptionBtnStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#DC2626" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 工业质感按钮样式 -->
        <Style x:Key="IndustrialBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#27272A" />
            <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderDarkBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#3F3F46" />
                                <Setter TargetName="bdr" Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#18181B" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bdr" Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="No" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 救砖操作强调按钮样式 -->
        <Style x:Key="RescueActionBtnStyle" TargetType="Button" BasedOn="{StaticResource IndustrialBtnStyle}">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="#38BDF8" />
            <Setter Property="Foreground" Value="#38BDF8" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#0284C7" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#0369A1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 三态硬件卡片外观触发器样式 -->
        <Style x:Key="TriStatePortCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#121215" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <!-- 状态 A: 离线未连接 (Unplugged - 灰色压暗) -->
                <DataTrigger Binding="{Binding State}" Value="{x:Static local:DeviceState.Unplugged}">
                    <Setter Property="BorderBrush" Value="#27272A" />
                    <Setter Property="Opacity" Value="0.65" />
                </DataTrigger>
                <!-- 状态 B: 驱动未就绪 / 异常设备 (Warning - 黄色高亮) -->
                <DataTrigger Binding="{Binding State}" Value="{x:Static local:DeviceState.Warning}">
                    <Setter Property="BorderBrush" Value="#F59E0B" />
                    <Setter Property="Opacity" Value="1.0" />
                    <Setter Property="Background" Value="#1C180B" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="12" Direction="0" ShadowDepth="0" Opacity="0.3" Color="#F59E0B"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <!-- 状态 C: 就绪正常 (Ready - 绿色就绪) -->
                <DataTrigger Binding="{Binding State}" Value="{x:Static local:DeviceState.Ready}">
                    <Setter Property="BorderBrush" Value="#10B981" />
                    <Setter Property="Opacity" Value="1.0" />
                    <Setter Property="Background" Value="#0E1613" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="12" Direction="0" ShadowDepth="0" Opacity="0.25" Color="#10B981"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 三态状态徽章样式 -->
        <Style x:Key="TriStateBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,2" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static local:DeviceState.Unplugged}">
                    <Setter Property="Background" Value="#27272A" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static local:DeviceState.Warning}">
                    <Setter Property="Background" Value="#78350F" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static local:DeviceState.Ready}">
                    <Setter Property="Background" Value="#064E3B" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TriStateBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static local:DeviceState.Unplugged}">
                    <Setter Property="Foreground" Value="#71717A" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static local:DeviceState.Warning}">
                    <Setter Property="Foreground" Value="#FBBF24" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static local:DeviceState.Ready}">
                    <Setter Property="Foreground" Value="#34D399" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- 主窗体根容器 -->
    <Grid Background="#18181B">
        <Grid.RowDefinitions>
            <!-- 行 0: 标题栏 (高 38) -->
            <RowDefinition Height="38" />
            <!-- 行 1: 主体工作区 -->
            <RowDefinition Height="*" />
            <!-- 行 2: 底部状态与版本号条 (高 32) -->
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- 1. 沉浸式隐形标题栏 (已彻底去除冗余“硬件架构”说明文本) -->
        <!-- ========================================================= -->
        <Border Grid.Row="0" Background="#121215" BorderBrush="#27272A" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- 左侧: 徽标与主标题 -->
                    <ColumnDefinition Width="Auto" />
                    <!-- 中间: 纯净留白拖拽区 (调试模式下显示工作模式提示) -->
                    <ColumnDefinition Width="*" />
                    <!-- 右侧: 开发者模式切换、总线刷新与窗口按钮 -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 左侧: 科技徽标 + 规范软件标题 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Path Data="M 12 2 L 2 7 L 12 12 L 22 7 Z M 2 17 L 12 22 L 22 17 M 2 12 L 12 17 L 22 12" 
                          Stroke="{StaticResource AccentCyanBrush}" StrokeThickness="1.8" 
                          HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Width="15" Height="15" Margin="0,0,9,0"/>
                    <TextBlock Text="LinkNexus" FontSize="13" FontWeight="Bold" Foreground="#FAFAFA" VerticalAlignment="Center"/>
                    <Border Background="#27272A" CornerRadius="3" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="多协议桌面硬件调试站" FontSize="10" Foreground="#A1A1AA" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- 中间: 原硬件架构说明已彻底去除，保留纯净拖拽区与调试模式就绪指示 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#1C1917" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="4" Padding="10,2">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDebugMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="#F59E0B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="🛠️ 开发者调试模式已激活：已解锁端口物理开关、固件放入与功能全量预览" 
                                       FontSize="11" FontWeight="SemiBold" Foreground="#F59E0B" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 右侧: 开发者模式切换按钮、总线刷新与窗口操作按钮组 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 开发者调试模式 (DEBUG) 快速切换徽章按钮 -->
                    <Button Style="{StaticResource CaptionBtnStyle}" Width="Auto" Height="26" Padding="8,0" Margin="0,0,10,0"
                            Command="{Binding ToggleDebugModeCommand}" WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="切换开发者调试模式 (快捷键: F12 或 连续点击版本号 5 次)">
                        <Border BorderThickness="1" CornerRadius="4" Padding="8,2">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#18181B" />
                                    <Setter Property="BorderBrush" Value="#27272A" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDebugMode}" Value="True">
                                            <Setter Property="Background" Value="#1C180B" />
                                            <Setter Property="BorderBrush" Value="#F59E0B" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#71717A" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDebugMode}" Value="True">
                                                    <Setter Property="Fill" Value="#F59E0B" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding DebugModeBadgeText}" FontSize="10" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#71717A" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDebugMode}" Value="True">
                                                    <Setter Property="Foreground" Value="#F59E0B" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Button>

                    <!-- 刷新总线按钮 -->
                    <Button Style="{StaticResource IndustrialBtnStyle}" Content="刷新总线" Height="26" Padding="8,2" Margin="0,0,12,0" 
                            Command="{Binding TriggerScanCommand}" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="立即触发 Windows PnP 全量设备枚举"/>

                    <!-- 最小化 -->
                    <Button Style="{StaticResource CaptionBtnStyle}" Click="BtnWindowMinimize_Click" ToolTip="最小化">
                        <Path Data="M 0 0 H 10" Stroke="{StaticResource TextNormalBrush}" StrokeThickness="1.2" SnapsToDevicePixels="True"/>
                    </Button>

                    <!-- 最大化 / 还原 -->
                    <Button Style="{StaticResource CaptionBtnStyle}" Click="BtnWindowMaximize_Click" ToolTip="最大化 / 还原">
                        <Path x:Name="PathMaximizeIcon" Data="M 0 0 H 10 V 10 H 0 Z" Stroke="{StaticResource TextNormalBrush}" StrokeThickness="1.2" SnapsToDevicePixels="True"/>
                    </Button>

                    <!-- 关闭 -->
                    <Button Style="{StaticResource CaptionCloseBtnStyle}" Click="BtnWindowClose_Click" ToolTip="关闭">
                        <Path Data="M 0 0 L 10 10 M 10 0 L 0 10" Stroke="{StaticResource TextNormalBrush}" StrokeThickness="1.2" SnapsToDevicePixels="True"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================= -->
        <!-- 2. 主体工作区 -->
        <!-- ========================================================= -->
        <Grid Grid.Row="1" Margin="16,12,16,8">
            <Grid.RowDefinitions>
                <!-- 顶部: 4 个物理端口卡片流 (支持 Debug 模式下开关端口与模拟) -->
                <RowDefinition Height="Auto" />
                <!-- 间距 -->
                <RowDefinition Height="12" />
                <!-- 底部: 供电互锁区 (左) + 实时 PnP 诊断 / 开发者功能预览控制台 (右) -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 2.1 核心 4 大物理端口卡片流 (端口 #1 ~ 端口 #4) -->
            <ItemsControl Grid.Row="0" ItemsSource="{Binding Ports}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource TriStatePortCardStyle}" Margin="4,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <!-- 端口序号与三态标签 -->
                                    <RowDefinition Height="Auto" />
                                    <!-- 引擎主标题与技术代号 -->
                                    <RowDefinition Height="Auto" />
                                    <!-- 描述 -->
                                    <RowDefinition Height="Auto" />
                                    <!-- 分割线 -->
                                    <RowDefinition Height="10" />
                                    <!-- 真实枚举技术参数矩阵 (2x2) -->
                                    <RowDefinition Height="Auto" />
                                    <!-- 底部状态描述条 -->
                                    <RowDefinition Height="Auto" />
                                    <!-- 开发者调试专属控制条 (仅 Debug 模式显示：可开关端口、模拟插拔) -->
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- 行 0: 端口序号 (严格规范：“端口 #1”、“端口 #2”……) + 状态三态标签 -->
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <Border Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding PortLabel}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                                    </Border>
                                    <Border Style="{StaticResource TriStateBadgeStyle}" HorizontalAlignment="Right">
                                        <TextBlock Style="{StaticResource TriStateBadgeTextStyle}" Text="{Binding StatusBadgeText}"/>
                                    </Border>
                                </Grid>

                                <!-- 行 1: 引擎全称 -->
                                <TextBlock Grid.Row="1" Text="{Binding TargetEngineName}" FontSize="13" FontWeight="Bold" Foreground="#FAFAFA" TextTrimming="CharacterEllipsis"/>

                                <!-- 行 2: 架构协议描述 -->
                                <TextBlock Grid.Row="2" Text="{Binding EngineDescription}" FontSize="10" Foreground="#71717A" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>

                                <!-- 行 3: 分割线 -->
                                <Border Grid.Row="3" BorderBrush="#27272A" BorderThickness="0,0,0,1" VerticalAlignment="Center" Margin="0,3"/>

                                <!-- 行 4: 真实 USB / 驱动枚举参数矩阵 -->
                                <Grid Grid.Row="4" Margin="0,2,0,6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 真实 VID/PID -->
                                    <Border Grid.Row="0" Grid.Column="0" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="4" Padding="7,5" Margin="0,0,3,4">
                                        <StackPanel>
                                            <TextBlock Text="USB 硬件识别码" FontSize="9" Foreground="#71717A"/>
                                            <TextBlock Text="{Binding VidPid}" FontFamily="Consolas, Segoe UI" FontSize="11" FontWeight="Bold" Foreground="#FAFAFA" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 虚拟串口 VCP -->
                                    <Border Grid.Row="0" Grid.Column="1" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="4" Padding="7,5" Margin="3,0,0,4">
                                        <StackPanel>
                                            <TextBlock Text="通信端口 (VCP)" FontSize="9" Foreground="#71717A"/>
                                            <TextBlock Text="{Binding ComPort}" FontFamily="Consolas, Segoe UI" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 设备序列号 -->
                                    <Border Grid.Row="1" Grid.Column="0" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="4" Padding="7,5" Margin="0,0,3,0">
                                        <StackPanel>
                                            <TextBlock Text="硬件序列号" FontSize="9" Foreground="#71717A"/>
                                            <TextBlock Text="{Binding SerialNumber}" FontFamily="Consolas, Segoe UI" FontSize="10" Foreground="#A1A1AA" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 系统拓扑识别 -->
                                    <Border Grid.Row="1" Grid.Column="1" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="4" Padding="7,5" Margin="3,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="设备管理器状态" FontSize="9" Foreground="#71717A"/>
                                            <TextBlock Text="{Binding DeviceFriendlyName}" FontSize="10" Foreground="#A1A1AA" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- 行 5: 底层状态诊断提示 -->
                                <Border Grid.Row="5" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="4" Padding="7,4">
                                    <TextBlock Text="{Binding StatusMessage}" FontSize="10" Foreground="#A1A1AA" TextTrimming="CharacterEllipsis"/>
                                </Border>

                                <!-- 行 6: 开发者调试模式专属控制区 (开关端口 / 循环模拟插拔) -->
                                <Border Grid.Row="6" Background="#1C180B" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="4" Margin="0,6,0,0" Padding="6,4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDebugMode}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 开关端口按钮 -->
                                        <Button Grid.Column="0" Style="{StaticResource IndustrialBtnStyle}" Height="24" Padding="4,0" FontSize="10"
                                                Command="{Binding TogglePortEnableCommand}"
                                                ToolTip="物理开关端口 MOS 供电与链路隔离">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="5" Height="5" Margin="0,0,4,0" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="#10B981" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPortEnabled}" Value="False">
                                                                    <Setter Property="Fill" Value="#EF4444" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding PortEnabledButtonText}" FontSize="9" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- 循环模拟插拔按钮 -->
                                        <Button Grid.Column="2" Style="{StaticResource IndustrialBtnStyle}" Content="模拟插拔" Height="24" Padding="4,0" FontSize="10"
                                                Command="{Binding ToggleSimulateStateCommand}"
                                                ToolTip="切换设备状态 (离线未接入 -> 正常就绪 -> 异常未就绪)"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 2.2 底部工作区分割：供电互锁区 (左) + 实时 PnP 诊断 / 开发者功能预览调试台 (右) -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <!-- 左侧: VBUS 下行供电硬件联动互锁卡片 (420 宽) -->
                    <ColumnDefinition Width="420" />
                    <!-- 间距 -->
                    <ColumnDefinition Width="14" />
                    <!-- 右侧: 实时 PnP 事件流 / 开发者功能预览控制台 -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左侧: 目标板下行供电输出 (VBUS) 硬件联动互锁控制 -->
                <Border Grid.Column="0" Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- 标题与联锁指示 -->
                            <RowDefinition Height="Auto" />
                            <!-- 核心开关大控制区 -->
                            <RowDefinition Height="*" />
                            <!-- 电气仪表与采样 -->
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 供电卡片标题 -->
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M 13 2 L 3 14 H 12 L 11 22 L 21 10 H 12 L 13 2 Z" Fill="#F59E0B" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="目标板下行供电输出 (VBUS)" FontSize="12" FontWeight="Bold" Foreground="#FAFAFA" VerticalAlignment="Center"/>
                            </StackPanel>
                            <!-- 互锁状态标签 -->
                            <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#78350F" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsVbusControlUnlocked}" Value="True">
                                                <Setter Property="Background" Value="#064E3B" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="10" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="🔒 硬件联锁已锁定" />
                                            <Setter Property="Foreground" Value="#FBBF24" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsVbusControlUnlocked}" Value="True">
                                                    <Setter Property="Text" Value="🔓 联锁就绪已解锁" />
                                                    <Setter Property="Foreground" Value="#34D399" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </Grid>

                        <!-- 核心开关与互锁说明 -->
                        <Border Grid.Row="1" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Margin="0,12" Padding="12">
                            <!-- 仅当 ESP32-S3 主控在线且握手成功时 IsEnabled=True；未连通前强制变灰锁定 -->
                            <Grid IsEnabled="{Binding IsVbusControlUnlocked}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- 互锁提示文字 -->
                                <TextBlock Grid.Row="0" Text="{Binding VbusInterlockStatusText}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#A1A1AA" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsVbusControlUnlocked}" Value="False">
                                                    <Setter Property="Foreground" Value="#F59E0B" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsVbusPowerEnabled}" Value="True">
                                                    <Setter Property="Foreground" Value="#10B981" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- 主开关 ToggleButton -->
                                <ToggleButton Grid.Row="1" IsChecked="{Binding IsVbusPowerEnabled, Mode=TwoWay}" Height="44" Cursor="Hand">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="toggleBdr" Background="#27272A" BorderBrush="#3F3F46" BorderThickness="1.5" CornerRadius="6">
                                                <Grid Margin="12,0">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse x:Name="stateDot" Width="8" Height="8" Fill="#71717A" Margin="0,0,10,0"/>
                                                        <TextBlock x:Name="stateTxt" Text="VBUS 供电输出关断 (OFF)" FontSize="12" FontWeight="Bold" Foreground="#A1A1AA" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="点击切换" FontSize="10" Foreground="#71717A" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="toggleBdr" Property="Background" Value="#064E3B" />
                                                    <Setter TargetName="toggleBdr" Property="BorderBrush" Value="#10B981" />
                                                    <Setter TargetName="stateDot" Property="Fill" Value="#10B981" />
                                                    <Setter TargetName="stateTxt" Property="Text" Value="⚡ VBUS 5.0V 供电开启 (ON)" />
                                                    <Setter TargetName="stateTxt" Property="Foreground" Value="#FAFAFA" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="toggleBdr" Property="Opacity" Value="0.4" />
                                                    <Setter Property="Cursor" Value="No" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <TextBlock Grid.Row="2" Text="硬件保护机制：主控离线即刻硬切断 MOS 通路，杜绝误供电冲击目标板。" FontSize="10" Foreground="#71717A" Margin="0,6,0,0"/>
                            </Grid>
                        </Border>

                        <!-- 下行供电高精度实测仪表 -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="5" Padding="12,8">
                                <StackPanel>
                                    <TextBlock Text="下行端口电压 (SENSE)" FontSize="9" Foreground="#71717A"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding VbusVoltage, StringFormat={}{0:F2}}" FontSize="17" FontWeight="Bold" Foreground="#38BDF8"/>
                                        <TextBlock Text=" V" FontSize="11" Foreground="#71717A" VerticalAlignment="Bottom" Margin="3,0,0,2"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="5" Padding="12,8">
                                <StackPanel>
                                    <TextBlock Text="下行回路电流 (INA236)" FontSize="9" Foreground="#71717A"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding VbusCurrent, StringFormat={}{0:F1}}" FontSize="17" FontWeight="Bold" Foreground="#10B981"/>
                                        <TextBlock Text=" mA" FontSize="11" Foreground="#71717A" VerticalAlignment="Bottom" Margin="3,0,0,2"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 右侧: 开发者功能预览控制台 (Debug 开启) / 实时 PnP 诊断事件流 (普通模式) -->
                <Border Grid.Column="2" Background="#121215" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- 顶部: 控制台模式切换栏 -->
                            <RowDefinition Height="Auto" />
                            <!-- 中间: 文件放入与解析区 (仅在 Debug 模式开启时显示) -->
                            <RowDefinition Height="Auto" />
                            <!-- 底部: 功能预览工作区 / PnP 诊断终端 -->
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 行 0: 控制台模式选择栏 -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="实时硬件诊断与功能预览工作台" FontSize="12" FontWeight="Bold" Foreground="#FAFAFA" VerticalAlignment="Center"/>
                                <Border Width="1" Height="12" Background="#27272A" Margin="10,0"/>

                                <!-- 视图切换器 -->
                                <RadioButton Content="PnP 硬件监控流" IsChecked="True" Foreground="#A1A1AA" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"
                                             Click="RdoPnpLogs_Click"/>
                                <RadioButton x:Name="RdoDebugPreview" Content="🛠️ 开发者功能预览调试" Foreground="#F59E0B" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                             Click="RdoDebugPreview_Click">
                                    <RadioButton.Style>
                                        <Style TargetType="RadioButton">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDebugMode}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </RadioButton.Style>
                                </RadioButton>
                            </StackPanel>

                            <Button Style="{StaticResource IndustrialBtnStyle}" Content="清空日志" Height="22" Padding="8,1" FontSize="10" 
                                    HorizontalAlignment="Right" Command="{Binding ClearLogsCommand}"/>
                        </Grid>

                        <!-- 行 1: 开发者固件/配置文件放入区 (Dropzone) - 仅在 Debug 模式显示 -->
                        <Border x:Name="BdrFileDropZone" Grid.Row="1" Background="#18181B" BorderBrush="#38BDF8" BorderThickness="1" 
                                CornerRadius="6" Padding="10,8" Margin="0,0,0,10"
                                AllowDrop="True" Drop="FileDropZone_Drop" DragOver="FileDropZone_DragOver">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDebugMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📂 放入文件:" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding CurrentLoadedFile.FileName}" FontSize="11" FontWeight="Bold" Foreground="#FAFAFA" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="文件大小: " FontSize="10" Foreground="#71717A"/>
                                        <TextBlock Text="{Binding CurrentLoadedFile.FileSizeText}" FontSize="10" Foreground="#A1A1AA" Margin="0,0,12,0"/>
                                        <TextBlock Text="CRC32: " FontSize="10" Foreground="#71717A"/>
                                        <TextBlock Text="{Binding CurrentLoadedFile.Crc32Text}" FontFamily="Consolas" FontSize="10" Foreground="#38BDF8" Margin="0,0,12,0"/>
                                        <TextBlock Text="匹配架构: " FontSize="10" Foreground="#71717A"/>
                                        <TextBlock Text="{Binding CurrentLoadedFile.TargetChipFamily}" FontSize="10" Foreground="#10B981"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource IndustrialBtnStyle}" Content="浏览放入文件..." Height="26" Padding="10,2"
                                            Command="{Binding BrowseFileCommand}" ToolTip="选择目标固件或配置文件放入调试"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 行 2: 容器内容切换 (视图 A: 开发者功能预览控制台 / 视图 B: PnP 诊断事件流) -->
                        <Grid Grid.Row="2">
                            <!-- 视图 A: 开发者全功能预览与调试工作台 -->
                            <Border x:Name="PnlDebugPreviewWorkbench" Background="#0C0C0E" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="10" Visibility="Collapsed">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <!-- 功能预览调试选项卡切换 -->
                                        <RowDefinition Height="Auto" />
                                        <!-- 选项卡对应调试面板 -->
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- 预览调试选项卡按钮组 -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                        <RadioButton x:Name="TabFlash" Content="固件烧录流水线调试" IsChecked="True" Foreground="#38BDF8" FontSize="10" FontWeight="SemiBold" Margin="0,0,14,0" Click="TabPreview_Click"/>
                                        <RadioButton x:Name="TabSerial" Content="虚拟串口回环测试" Foreground="#38BDF8" FontSize="10" FontWeight="SemiBold" Margin="0,0,14,0" Click="TabPreview_Click"/>
                                        <RadioButton x:Name="TabLoad" Content="VBUS 动态负载阶跃" Foreground="#38BDF8" FontSize="10" FontWeight="SemiBold" Margin="0,0,14,0" Click="TabPreview_Click"/>
                                        <RadioButton x:Name="TabProtocol" Content="ESP32 二进制协议帧" Foreground="#38BDF8" FontSize="10" FontWeight="SemiBold" Click="TabPreview_Click"/>
                                    </StackPanel>

                                    <!-- 选项卡 1: 固件烧录流水线调试 -->
                                    <Grid x:Name="ViewFlashPreview" Grid.Row="1" Visibility="Visible">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                            <Button Style="{StaticResource RescueActionBtnStyle}" Content="▶ 启动固件烧录流水线预览" Height="28" Padding="14,0" 
                                                    Command="{Binding StartPreviewFlashCommand}" ToolTip="执行流式写入、扇区擦除与 CRC32 校验比对全流程"/>
                                            <TextBlock Text="{Binding FlashSpeedText, StringFormat=传输速率：{0}}" FontSize="11" Foreground="#38BDF8" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                            <TextBlock Text="{Binding FlashProgress, StringFormat=进度：{0}%}" FontSize="11" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                        </StackPanel>

                                        <!-- 烧录进度条 -->
                                        <ProgressBar Grid.Row="1" Height="6" Value="{Binding FlashProgress}" Minimum="0" Maximum="100" 
                                                     Foreground="#38BDF8" Background="#27272A" BorderThickness="0" Margin="0,0,0,6"/>

                                        <TextBlock Grid.Row="2" Text="{Binding FlashStatusStep}" FontSize="10" Foreground="#A1A1AA" Margin="0,0,0,8"/>

                                        <!-- 烧录流程执行步骤说明 -->
                                        <Border Grid.Row="3" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="5" Padding="10">
                                            <StackPanel>
                                                <TextBlock Text="⚡ 烧录流水线执行标准：" FontSize="11" FontWeight="Bold" Foreground="#FAFAFA" Margin="0,0,0,6"/>
                                                <TextBlock Text="1. SWD 10MHz 总线握手建立并挂起目标 MCU 内核 (Halt &amp; Unlock DAP)" FontSize="10" Foreground="#71717A"/>
                                                <TextBlock Text="2. 扇区快速擦除 (Sector Erase 0x08000000 - 0x08040000)" FontSize="10" Foreground="#71717A" Margin="0,2,0,0"/>
                                                <TextBlock Text="3. 流式分块写入固件数据包 (218 KB/s 高速并口写入)" FontSize="10" Foreground="#71717A" Margin="0,2,0,0"/>
                                                <TextBlock Text="4. 读取片上硬件 CRC32 寄存器严格比对镜像 (0x9B41E280)，软复位内核 (SYSRESETREQ)" FontSize="10" Foreground="#71717A" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- 选项卡 2: 虚拟串口回环测试 -->
                                    <Grid x:Name="ViewSerialPreview" Grid.Row="1" Visibility="Collapsed">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding SerialSendBuffer, UpdateSourceTrigger=PropertyChanged}" 
                                                     Height="26" Background="#18181B" Foreground="#FAFAFA" BorderBrush="#27272A" Padding="6,2" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Style="{StaticResource IndustrialBtnStyle}" Content="发送数据" Height="26" Margin="6,0,0,0" 
                                                    Command="{Binding SendSerialTextCommand}"/>
                                            <Button Grid.Column="2" Style="{StaticResource IndustrialBtnStyle}" Content="清空回环" Height="26" Margin="6,0,0,0" 
                                                    Command="{Binding ClearSerialMonitorCommand}"/>
                                        </Grid>

                                        <Border Grid.Row="1" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="4" Padding="6">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding SerialMonitorLines}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11" Foreground="#34D399" Margin="0,1"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>

                                    <!-- 选项卡 3: VBUS 动态负载阶跃调试 -->
                                    <Grid x:Name="ViewLoadPreview" Grid.Row="1" Visibility="Collapsed">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="⚡ 目标板供电负载阶跃仿真调试 (测试过流保护与母线瞬态压降)" FontSize="11" FontWeight="Bold" Foreground="#FAFAFA" Margin="0,0,0,10"/>
                                            <WrapPanel>
                                                <Button Style="{StaticResource IndustrialBtnStyle}" Content="0 mA (空载待机)" Margin="0,0,8,6" Command="{Binding SetSimulatedLoadCommand}" CommandParameter="0"/>
                                                <Button Style="{StaticResource IndustrialBtnStyle}" Content="150 mA (轻载运行)" Margin="0,0,8,6" Command="{Binding SetSimulatedLoadCommand}" CommandParameter="150"/>
                                                <Button Style="{StaticResource IndustrialBtnStyle}" Content="500 mA (标称全速)" Margin="0,0,8,6" Command="{Binding SetSimulatedLoadCommand}" CommandParameter="500"/>
                                                <Button Style="{StaticResource IndustrialBtnStyle}" Content="1200 mA (重载峰值)" Margin="0,0,8,6" Command="{Binding SetSimulatedLoadCommand}" CommandParameter="1200"/>
                                                <Button Style="{StaticResource IndustrialBtnStyle}" Content="2000 mA (触发过流阈值)" Margin="0,0,8,6" Command="{Binding SetSimulatedLoadCommand}" CommandParameter="2000"/>
                                            </WrapPanel>
                                            <TextBlock Text="提示：点击阶跃电流将动态更新左侧实测电流与母线电压响应波形。" FontSize="10" Foreground="#71717A" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 选项卡 4: ESP32 二进制协议帧校验 -->
                                    <Grid x:Name="ViewProtocolPreview" Grid.Row="1" Visibility="Collapsed">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="🛠️ ESP32-S3 全双工二进制防粘包协议帧构造与校验和测试" FontSize="11" FontWeight="Bold" Foreground="#FAFAFA" Margin="0,0,0,10"/>
                                            <WrapPanel>
                                                <Button Style="{StaticResource IndustrialBtnStyle}" Content="发送 0x01 心跳包" Margin="0,0,8,6" Command="{Binding SendTestProtocolFrameCommand}" CommandParameter="0x01 心跳包"/>
                                                <Button Style="{StaticResource IndustrialBtnStyle}" Content="发送 0x10 INA236 遥测请求" Margin="0,0,8,6" Command="{Binding SendTestProtocolFrameCommand}" CommandParameter="0x10 遥测数据"/>
                                                <Button Style="{StaticResource IndustrialBtnStyle}" Content="发送 0x30 通道 MOS 供电控制" Margin="0,0,8,6" Command="{Binding SendTestProtocolFrameCommand}" CommandParameter="0x30 供电控制"/>
                                            </WrapPanel>
                                            <TextBlock Text="发送测试帧将在日志终端输出完整的十六进制原始字节与校验和比对结果。" FontSize="10" Foreground="#71717A" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- 视图 B: 实时 PnP 诊断事件流控制台 (Terminal Log) -->
                            <Border x:Name="PnlPnpLogs" Background="#0C0C0E" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Visibility="Visible">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="8">
                                    <ItemsControl ItemsSource="{Binding Logs}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- 时间戳 -->
                                                    <TextBlock Grid.Column="0" Text="{Binding TimeString, StringFormat=[{0}]}" 
                                                               FontFamily="Consolas" FontSize="10" Foreground="#71717A" Margin="0,0,8,0" VerticalAlignment="Center"/>

                                                    <!-- 级别胶囊 -->
                                                    <Border Grid.Column="1" CornerRadius="3" Padding="4,1" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#27272A" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Level}" Value="SUCCESS">
                                                                        <Setter Property="Background" Value="#064E3B" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Level}" Value="WARN">
                                                                        <Setter Property="Background" Value="#78350F" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Level}" Value="ERROR">
                                                                        <Setter Property="Background" Value="#7F1D1D" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Level}" FontSize="9" FontWeight="Bold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#A1A1AA" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Level}" Value="SUCCESS">
                                                                            <Setter Property="Foreground" Value="#34D399" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Level}" Value="WARN">
                                                                            <Setter Property="Foreground" Value="#FBBF24" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Level}" Value="ERROR">
                                                                            <Setter Property="Foreground" Value="#F87171" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>

                                                    <!-- 消息正文 -->
                                                    <TextBlock Grid.Column="2" Text="{Binding Message}" FontFamily="Consolas, Microsoft YaHei" FontSize="11" 
                                                               Foreground="#D4D4D8" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ========================================================= -->
        <!-- 3. 底部状态与版本号条 (暗门触发区域) -->
        <!-- ========================================================= -->
        <Border Grid.Row="2" Background="#121215" BorderBrush="#27272A" BorderThickness="0,1,0,0" Padding="14,0">
            <Grid>
                <!-- 左侧: 状态简述 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,6,0"/>
                    <TextBlock Text="LinkNexus 物理拓扑守护服务正常运行中" FontSize="11" Foreground="#71717A" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 右侧: 规范版本号格式 vXXxx.YYWW (XXX) 与 5 次连击暗门 -->
                <Button Style="{StaticResource CaptionBtnStyle}" Height="24" Width="Auto" Padding="8,0" HorizontalAlignment="Right"
                        Command="{Binding VersionClickCommand}" 
                        ToolTip="工程规范版本号：vXXxx.YYWW (XXX) | 连续快速点击 5 次切换开发者调试模式">
                    <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="4" Padding="7,2">
                        <TextBlock Text="{Binding VersionString}" FontFamily="Consolas, Segoe UI" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                    </Border>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
