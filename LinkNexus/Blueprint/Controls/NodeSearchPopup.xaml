<UserControl x:Class="LinkNexus.Blueprint.Controls.NodeSearchPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:LinkNexus.Blueprint.Core"
             xmlns:vm="clr-namespace:LinkNexus.Blueprint.ViewModels"
             Visibility="Collapsed"
             Panel.ZIndex="999"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="WatermarkStyle" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasSearchText}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SearchListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="8,6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentCyanBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource CardSelectedBgBrush}" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentCyanBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- 内嵌画布硬件加速叠加层：无 Win32 分层透明 HWND、无软件高斯模糊阴影，实现 <0.5ms 零延迟秒开 -->
    <Grid x:Name="OverlayRoot" Background="Transparent">
        <!-- 点击卡片外部空白区域立即关闭浮层 -->
        <Border Background="Transparent"
                MouseLeftButtonDown="Backdrop_MouseDown"
                MouseRightButtonDown="Backdrop_MouseDown" />

        <!-- 轻量高对比度暗黑/白昼自适应搜索卡片 -->
        <Border x:Name="PopupCardBorder"
                Width="380"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AccentCyanBrush}"
                BorderThickness="1.2"
                CornerRadius="8"
                Padding="12,10"
                SnapsToDevicePixels="True">
            <Border.RenderTransform>
                <TranslateTransform x:Name="PopupCardTransform" X="0" Y="0" />
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- 搜索框 -->
                    <RowDefinition Height="Auto" /> <!-- 拉线过滤提示徽章 -->
                    <RowDefinition Height="288" />  <!-- 固定视口高度以激活 VirtualizingStackPanel 容器回收虚拟化 -->
                    <RowDefinition Height="Auto" /> <!-- 底部按键指引 -->
                </Grid.RowDefinitions>

                <!-- 0: 顶部搜索框 -->
                <Border Grid.Row="0"
                        Background="{DynamicResource AppTerminalBgBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,5"
                        Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Path Grid.Column="0"
                              Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                              Fill="{DynamicResource AppTextMutedBrush}"
                              Width="13" Height="13"
                              Stretch="Uniform"
                              Margin="2,0,8,0"
                              VerticalAlignment="Center" />

                        <TextBox x:Name="SearchTextBox"
                                 Grid.Column="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource AppTextPrimaryBrush}"
                                 CaretBrush="{DynamicResource AccentCyanBrush}"
                                 FontSize="12"
                                 FontFamily="Consolas, Segoe UI"
                                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="SearchTextBox_PreviewKeyDown"
                                 VerticalAlignment="Center" />

                        <TextBlock Grid.Column="1"
                                   IsHitTestVisible="False"
                                   Text="搜索卡片 (如: 积分, km, +, math)..."
                                   Foreground="{DynamicResource AppTextMutedBrush}"
                                   Opacity="0.65"
                                   FontSize="11.5"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource WatermarkStyle}" />
                    </Grid>
                </Border>

                <!-- 1: UE5 拉线松手兼容过滤徽章 -->
                <Border Grid.Row="1"
                        Visibility="{Binding IsPinFilterActive, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource AppSurfaceSubtleBrush}"
                        BorderBrush="{DynamicResource AccentCyanBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8,5"
                        Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentCyanBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding PinFilterDescription}"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource AccentCyanBrush}"
                                   FontFamily="Consolas, Segoe UI"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- 2: 虚拟化节点列表 (开启 Recycling 容器复用，杜绝打开弹窗时的 VisualTree 重建卡顿) -->
                <ListBox x:Name="NodesListBox"
                         Grid.Row="2"
                         ItemsSource="{Binding FilteredItems}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource SearchListBoxItemStyle}"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         MouseDoubleClick="NodesListBox_MouseDoubleClick"
                         PreviewMouseLeftButtonUp="NodesListBox_PreviewMouseLeftButtonUp">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type core:NodeRegistryItem}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 左侧分类色阶竖条 -->
                                <Border Grid.Column="0"
                                        Width="3"
                                        CornerRadius="1.5"
                                        Background="{Binding ColorHex}"
                                        Margin="0,0,8,0" />

                                <StackPanel Grid.Column="1">
                                    <DockPanel LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Left"
                                                   Text="{Binding Title}"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding Category}"
                                                   FontSize="9.5"
                                                   Foreground="{DynamicResource AppTextMutedBrush}"
                                                   FontFamily="Consolas"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Description}"
                                               FontSize="10"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                                               Opacity="0.82"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 3: 底部快捷键操作指引 -->
                <DockPanel Grid.Row="3" Margin="2,8,2,0" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left"
                               Text="↑↓ 切换 · Enter 实例化 · Esc 关闭"
                               FontSize="10"
                               Foreground="{DynamicResource AppTextMutedBrush}"
                               FontFamily="Consolas" />
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding FilteredCountText}"
                               FontSize="10"
                               Foreground="{DynamicResource AppTextMutedBrush}"
                               FontFamily="Consolas" />
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
